@if (IsOpen)
{
    <div class="confirm-overlay"
         @onclick="HandleOverlayClick">

        <div class="confirm-dialog"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="confirm-title"
             aria-describedby="confirm-message"
             @onclick:stopPropagation="true">

            <button type="button"
                    class="confirm-close"
                    aria-label="Close"
                    disabled="@IsProcessing"
                    @onclick="Cancel">
                ×
            </button>

            <div class="confirm-icon">
                <span>!</span>
            </div>

            <div class="confirm-content">

                <h2 id="confirm-title">
                    @Title
                </h2>

                <p id="confirm-message">
                    @Message
                </p>

            </div>

            <div class="confirm-actions">

                <button type="button"
                        class="confirm-button cancel"
                        disabled="@IsProcessing"
                        @onclick="Cancel">
                    @CancelText
                </button>

                <button type="button"
                        class="confirm-button danger"
                        disabled="@IsProcessing"
                        @onclick="Confirm">

                    @if (IsProcessing)
                    {
                        <span class="confirm-spinner"></span>
                        <span>@ProcessingText</span>
                    }
                    else
                    {
                        <span>@ConfirmText</span>
                    }

                </button>

            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Are you sure?";

    [Parameter]
    public string Message { get; set; }
        = "This action cannot be undone.";

    [Parameter]
    public string ConfirmText { get; set; } = "Delete";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    [Parameter]
    public string ProcessingText { get; set; } = "Deleting...";

    [Parameter]
    public bool IsProcessing { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task Confirm()
    {
        if (IsProcessing)
            return;

        await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        if (IsProcessing)
            return;

        await OnCancel.InvokeAsync();
    }

    private async Task HandleOverlayClick()
    {
        if (!IsProcessing)
        {
            await Cancel();
        }
    }
}