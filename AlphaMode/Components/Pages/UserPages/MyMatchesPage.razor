@page "/dashboard/matches"
@rendermode InteractiveServer
@layout AlphaMode.Components.Layout.UserLayout
@using AlphaMode.Application.Dashboards.DTOs
@using AlphaMode.Application.Dashboards.Interfaces
@using AlphaMode.Components.Sections.UserSectionComponents
@using AlphaMode.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject IDashboardQueryService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My matches | AlphaMode</PageTitle>
<PortalPageHeader Eyebrow="Competition" Title="My matches" Description="Review every tournament, friendly, and exhibition match assigned to you." />

@* One database query now combines tournament and friendly matches for the signed-in player. *@
<div class="portal-filter-row">
    @foreach (var value in new[] { "All", "Upcoming", "Completed" })
    { <button class="@(filter == value ? "active" : null)" @onclick="() => filter = value">@value @if(value == "All"){<span>@matches.Count</span>}</button> }
</div>

@if (isLoading) { <ContentSkeleton Rows="5" /> }
else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> }
else if (!FilteredMatches.Any()) { <EmptyState Title="No matches yet" Message="Tournament and friendly matches will appear here after fixtures are generated or scheduled." /> }
else
{
    <section class="match-card-grid three">
        @foreach (var match in FilteredMatches)
        {
            <article class="portal-match-card">
                <header><span class="portal-status open">@match.CompetitionName</span><small>@(match.IsRanked ? "Ranked · affects Elo" : "Unranked · no Elo impact")</small></header>
                <div class="match-opponents"><strong>@match.PlayerOneName</strong><span>@FormatScore(match)</span><strong>@match.PlayerTwoName</strong></div>
                <footer><span>@match.GameName</span><span>@(match.ScheduledAt?.ToLocalTime().ToString("dd MMM yyyy · HH:mm") ?? "Time to be confirmed")</span><b>@match.Status</b></footer>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<UserMatchDto> matches = [];
    private string filter = "All";
    private string? errorMessage;
    private bool isLoading;

    private IEnumerable<UserMatchDto> FilteredMatches => filter switch
    {
        "Upcoming" => matches.Where(x => x.Status is MatchStatus.Pending or MatchStatus.Scheduled or MatchStatus.Live),
        "Completed" => matches.Where(x => x.Status == MatchStatus.Completed),
        _ => matches
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true; errorMessage = null;
        try {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrWhiteSpace(userId)) { errorMessage = "Your player identity could not be loaded."; return; }
            var result = await DashboardService.GetUserMatchesAsync(userId);
            if (!result.Succeeded) { errorMessage = result.Error ?? "Your matches could not be loaded."; return; }
            matches = result.Value ?? [];
        } finally { isLoading = false; }
    }

    private static string FormatScore(UserMatchDto match) => match.PlayerOneScore.HasValue ? $"{match.PlayerOneScore} – {match.PlayerTwoScore}" : "VS";
}

