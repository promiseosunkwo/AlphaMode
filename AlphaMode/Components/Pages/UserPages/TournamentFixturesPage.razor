@page "/dashboard/fixtures"
@layout AlphaMode.Components.Layout.UserLayout
@using AlphaMode.Components.Sections.UserSectionComponents
@using AlphaMode.Data
<PageTitle>Fixtures | AlphaMode</PageTitle>
<PortalPageHeader Eyebrow="Alpha Cup" Title="Tournament fixtures" Description="Follow your path through every round of the competition.">
    <Actions><select class="portal-select" aria-label="Select tournament"><option>Alpha Cup · EA FC 26</option><option>Elite Series · Tekken 8</option></select></Actions>
</PortalPageHeader>
<section class="fixture-summary"><div><span class="game-tile">FC</span><div><small>Current tournament</small><h2>Alpha Cup</h2><p>Single elimination · 32 players · £1,000 prize pool</p></div></div><span class="portal-status live">Round 1</span></section>
<section class="portal-panel"><div class="portal-section-heading"><div><span>Bracket schedule</span><h2>Your fixture path</h2></div><small>Times shown in local time</small></div>
    <div class="fixture-timeline">@foreach (var fixture in UserPortalSampleData.Fixtures) { <article class="fixture-row @(fixture.IsCurrentUserFixture ? "is-player" : "")"><div class="fixture-round">R@fixture.Round</div><div class="fixture-players"><strong>@fixture.PlayerOne</strong><span>vs</span><strong>@fixture.PlayerTwo</strong></div><div class="fixture-time"><strong>@fixture.ScheduledAt.ToString("ddd dd MMM")</strong><small>@fixture.ScheduledAt.ToString("HH:mm") · @fixture.Station</small></div><span class="portal-status @(fixture.Status == "Scheduled" ? "open" : "pending")">@fixture.Status</span></article> }</div>
</section>
<aside class="portal-callout"><span>i</span><div><strong>Match check-in</strong><p>Check in 15 minutes before your scheduled match. Missing check-in may result in a forfeit.</p></div><a href="dashboard/matches">Open matches</a></aside>

