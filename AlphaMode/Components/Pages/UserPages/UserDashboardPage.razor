@page "/dashboard"
@rendermode InteractiveServer
@layout AlphaMode.Components.Layout.UserLayout
@using AlphaMode.Application.Dashboards.DTOs
@using AlphaMode.Application.Dashboards.Interfaces
@using AlphaMode.Components.Sections.UserSectionComponents
@using Microsoft.AspNetCore.Components.Authorization
@inject IDashboardQueryService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Player overview | AlphaMode</PageTitle>
<PortalPageHeader Eyebrow="Dashboard" Title="@(dashboard?.GamerTag ?? "Player overview")" Description="Your live competitive activity, progress, and next steps in one place."><Actions><a class="portal-button primary" href="/dashboard/tournaments">Find a tournament <span>→</span></a></Actions></PortalPageHeader>

@if (isLoading) { <ContentSkeleton Rows="8" /> }
else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> }
else if (dashboard is not null)
{
    @* Profile and performance values now come from the signed-in player's database record. *@
    <section class="profile-hero"><div class="profile-avatar">@Initials(dashboard.GamerTag)<span></span></div><div class="profile-identity"><small>Active player</small><h2>@dashboard.DisplayName</h2><p>@($"@{dashboard.GamerTag}")</p></div><div class="level-progress"><div><span>Competitive rating</span><strong>@dashboard.EloRating.ToString("0") Elo</strong></div><small>@(dashboard.Rank.HasValue ? $"Game rank #{dashboard.Rank}" : "Complete a ranked match to place")</small></div></section>
    <section class="portal-stats-grid" aria-label="Performance summary"><PortalStatCard Icon="◉" Label="Matches played" Value="@dashboard.MatchesPlayed.ToString()" Detail="Recorded results" /><PortalStatCard Icon="✓" Label="Wins" Value="@dashboard.Wins.ToString()" Detail="@($"{WinRate(dashboard)}% win rate")" Accent="positive" /><PortalStatCard Icon="↗" Label="Game rank" Value="@(dashboard.Rank.HasValue ? $"#{dashboard.Rank}" : "—")" Detail="Ranked matches only" Accent="primary" /><PortalStatCard Icon="◆" Label="Elo rating" Value="@dashboard.EloRating.ToString("0")" Detail="Competitive rating" /></section>
    <div class="portal-dashboard-grid">
        <section class="portal-panel span-two"><div class="portal-section-heading"><div><span>Schedule</span><h2>Upcoming matches</h2></div><a href="/dashboard/matches">View all</a></div>
            @if (dashboard.UpcomingMatches.Count == 0) { <EmptyState Title="No upcoming matches" Message="Scheduled tournament and friendly matches will appear here." /> }
            else { <div class="match-card-grid">@foreach (var match in dashboard.UpcomingMatches.Take(2)) { <article class="portal-match-card"><header><span class="portal-status open">@match.CompetitionName</span><small>@(match.IsRanked ? "Ranked" : "Unranked")</small></header><div class="match-opponents"><strong>@match.PlayerOneName</strong><span>VS</span><strong>@match.PlayerTwoName</strong></div><footer><span>@match.GameName</span><span>@FormatDate(match.ScheduledAt)</span><b>@match.Status</b></footer></article> }</div> }
        </section>
        <section class="portal-panel ranking-preview"><div class="portal-section-heading"><div><span>Leaderboard</span><h2>Your position</h2></div><a href="/dashboard/ranking">Full ranking</a></div><div class="rank-orbit"><strong>@(dashboard.Rank.HasValue ? $"#{dashboard.Rank}" : "—")</strong><span>Game rank</span></div><h3>@dashboard.EloRating.ToString("0") Elo</h3><p>Only completed ranked tournament matches affect this rating.</p></section>
        <section class="portal-panel span-two"><div class="portal-section-heading"><div><span>Competitions</span><h2>Your tournaments</h2></div><a href="/dashboard/my-tournaments">View all</a></div>
            @if (dashboard.Tournaments.Count == 0) { <EmptyState Title="No tournament registrations" Message="Register for a tournament to see it here." /> }
            else { @foreach (var tournament in dashboard.Tournaments) { <div class="compact-tournament"><span class="game-tile">@Initials(tournament.GameName)</span><div><strong>@tournament.Name</strong><small>@tournament.GameName · @tournament.StartDate.ToLocalTime().ToString("dd MMM")</small></div><span class="portal-status open">@tournament.Status</span><a href="/dashboard/fixtures">Fixtures →</a></div> } }
        </section>
        <section class="portal-panel"><div class="portal-section-heading"><div><span>Inbox</span><h2>Notifications</h2></div><a href="/dashboard/notifications">View all</a></div><div class="notification-preview">@if (!dashboard.Notifications.Any(x => !x.IsRead)) { <p>You are all caught up.</p> } else { @foreach (var item in dashboard.Notifications.Where(x => !x.IsRead).Take(3)) { <a href="/dashboard/notifications"><span></span><div><strong>@item.Title</strong><small>@item.Message</small></div></a> } }</div></section>
    </div>
}

@code {
    private UserDashboardDto? dashboard; private bool isLoading; private string? errorMessage;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { isLoading = true; errorMessage = null; try { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; if (string.IsNullOrWhiteSpace(userId)) { errorMessage = "Your identity could not be loaded."; return; } var result = await DashboardService.GetUserDashboardAsync(userId); if (!result.Succeeded) { errorMessage = result.Error; return; } dashboard = result.Value; } finally { isLoading = false; } }
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static decimal WinRate(UserDashboardDto value) => value.MatchesPlayed == 0 ? 0 : Math.Round((decimal)value.Wins / value.MatchesPlayed * 100, 1);
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("dd MMM · HH:mm") ?? "Time TBC";
}

