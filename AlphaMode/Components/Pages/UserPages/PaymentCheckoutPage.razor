@page "/dashboard/checkout/{RegistrationId:guid}"
@layout AlphaMode.Components.Layout.UserLayout
@rendermode InteractiveServer

@using System.Security.Claims
@using AlphaMode.Application.Payments.DTOs
@using AlphaMode.Application.Payments.Interfaces
@using AlphaMode.Domain.Enums
@using AlphaMode.Components.Sections.UserSectionComponents
@using AlphaMode.Services

@inject IPaymentService PaymentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Checkout | AlphaMode</PageTitle>

<BackNavigation Href="/dashboard/my-tournaments" Label="Back to my tournaments" />

<PortalPageHeader Eyebrow="Tournament entry"
                  Title="Complete payment"
                  Description="Secure your place in the tournament." />


@if (isLoading)
{
    <section class="checkout-shell">
        <div class="checkout-card">
            <p>Preparing your checkout...</p>
        </div>
    </section>
}
else if (checkout is null)
{
    <section class="checkout-shell">

        <div class="checkout-card checkout-error">

            <h2>Checkout unavailable</h2>

            <p>
                @errorMessage
            </p>

            <button type="button"
                    class="portal-button subtle"
                    @onclick="BackToTournaments">
                Back to tournaments
            </button>

        </div>

    </section>
}
else
{
    <section class="checkout-shell">

        <div class="checkout-main">

            <div class="checkout-card">

                <span class="checkout-eyebrow">
                    Tournament
                </span>

                <h2>
                    @checkout.TournamentName
                </h2>

                <div class="checkout-reference">

                    <span>Payment reference</span>

                    <strong>
                        @checkout.TransactionReference
                    </strong>

                </div>

            </div>


            <div class="checkout-card">

                <h3>Payment method</h3>

                <p class="checkout-muted">
                    Secure online payment will be processed
                    through AlphaMode's payment provider.
                </p>


                <div class="payment-method selected">

                    <div class="payment-method-icon">
                        💳
                    </div>

                    <div>
                        <strong>Online payment</strong>

                        <span>
                            Card, bank transfer or supported
                            provider methods
                        </span>
                    </div>

                </div>

            </div>

        </div>


        <aside class="checkout-summary">

            <div class="checkout-card">

                <span class="checkout-eyebrow">
                    Order summary
                </span>

                <div class="summary-row">

                    <span>Entry fee</span>

                    <strong>
                        @FormatMoney(
                        checkout.Amount,
                                        checkout.Currency)
                </strong>

            </div>


            <div class="summary-divider"></div>


            <div class="summary-row total">

                <span>Total</span>

                <strong>
                    @FormatMoney(
                                        checkout.Amount,
                                        checkout.Currency)
                </strong>

            </div>


            <button type="button"
                    class="portal-button primary checkout-pay"
                    disabled="@isStartingPayment"
                    @onclick="StartPaymentAsync">

                @(isStartingPayment
                                ? "Preparing payment..."
                                : $"Pay {FormatMoney(checkout.Amount, checkout.Currency)}")

            </button>


                <p class="checkout-security">
                    Your registration will only be confirmed
                    after payment has been verified.
                </p>

            </div>

        </aside>

    </section>
}


@code {

    [Parameter]
    public Guid RegistrationId { get; set; }

    private PaymentCheckoutDto? checkout;

    private bool isLoading = true;

    private bool isStartingPayment;

    private string? currentUserId;

    private string errorMessage =
        "We could not prepare this payment.";


    protected override async Task OnParametersSetAsync()
    {
        await PrepareCheckoutAsync();
    }


    private async Task PrepareCheckoutAsync()
    {
        isLoading = true;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            currentUserId =
                authenticationState.User
                    .FindFirstValue(
                        ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(
                    currentUserId))
            {
                errorMessage =
                    "You need to sign in before making a payment.";

                return;
            }

            var result =
                await PaymentService
                    .GetOrCreateTournamentPaymentAsync(
                        RegistrationId,
                        currentUserId);

            if (!result.Succeeded ||
                result.Value is null)
            {
                errorMessage =
                    result.Error ??
                    "Unable to prepare checkout.";

                return;
            }

            checkout =
                result.Value;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "Something went wrong while preparing checkout.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task StartPaymentAsync()
    {
        if (checkout is null ||
            isStartingPayment)
            return;

        isStartingPayment = true;

        try
        {
            /*
             * NEXT STEP:
             *
             * This is where IPaymentGateway will initialise
             * Paystack / Flutterwave.
             *
             * The gateway will return an authorization URL.
             *
             * We then redirect the browser:
             *
             * Navigation.NavigateTo(
             *     result.Value.AuthorizationUrl,
             *     forceLoad: true);
             */

            Toast.Info(
                "Payment gateway connection is the next step.");
        }
        finally
        {
            isStartingPayment = false;
        }
    }


    private void BackToTournaments()
    {
        Navigation.NavigateTo(
            "/dashboard/tournaments");
    }


    private static string FormatMoney(
        decimal amount,
        string currency)
    {
        return currency.ToUpperInvariant() switch
        {
            "NGN" => $"₦{amount:N0}",
            "GBP" => $"£{amount:N2}",
            "USD" => $"${amount:N2}",
            "EUR" => $"€{amount:N2}",
            _ => $"{currency} {amount:N2}"
        };
    }
}

