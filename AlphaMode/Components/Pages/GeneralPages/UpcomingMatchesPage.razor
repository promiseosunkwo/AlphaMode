@page "/upcoming-matches"
@rendermode InteractiveServer
@using AlphaMode.Application.Dashboards.DTOs
@using AlphaMode.Application.Dashboards.Interfaces
@using AlphaMode.Components.Sections.Shared
@using AlphaMode.Domain.Enums
@inject IDashboardQueryService DashboardService

<PageTitle>Upcoming matches | AlphaMode</PageTitle><div class="alpha-page"><Navbar /><main class="public-main"><section class="public-hero"><div><span>Match centre</span><h1>Upcoming fixtures</h1><p>Published tournament matches, scheduled times, games, and rounds in one place.</p></div><a class="public-button secondary" href="/live-matches">View live matches</a></section><section class="public-section">
@if (isLoading) { <ContentSkeleton Rows="7" /> } else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> } else if (!Upcoming.Any()) { <EmptyState Title="No upcoming fixtures" Message="Scheduled tournament matches will appear here after fixtures are generated." /> } else { <div class="public-fixture-list">@foreach (var match in PagedUpcoming) { <article class="public-fixture"><time><strong>@(match.ScheduledAt?.ToLocalTime().ToString("dd") ?? "—")</strong><span>@(match.ScheduledAt?.ToLocalTime().ToString("MMM · HH:mm") ?? "Time TBC")</span></time><div><small>@match.CompetitionName · Round @match.RoundNumber</small><h2>@match.PlayerOneName <em>vs</em> @match.PlayerTwoName</h2><p>@match.GameName</p></div><span class="public-pill">@match.Status</span></article> }</div><Pagination CurrentPage="page" CurrentPageChanged="ChangePage" PageSize="PageSize" TotalItems="@Upcoming.Count" AriaLabel="Upcoming fixture pages" /> }
</section></main><Footer /></div>
@code { private const int PageSize = 10; private IReadOnlyList<UserMatchDto> matches = []; private int page = 1; private bool isLoading; private string? errorMessage; private IReadOnlyList<UserMatchDto> Upcoming => matches.Where(x => x.Status is MatchStatus.Pending or MatchStatus.Scheduled).OrderBy(x => x.ScheduledAt).ToList(); private IEnumerable<UserMatchDto> PagedUpcoming => Upcoming.Skip((page - 1) * PageSize).Take(PageSize); protected override Task OnInitializedAsync() => LoadAsync(); private async Task LoadAsync() { isLoading = true; errorMessage = null; try { var result = await DashboardService.GetPublicTournamentMatchesAsync(); if (!result.Succeeded) { errorMessage = result.Error; return; } matches = result.Value ?? []; page = 1; } finally { isLoading = false; } } private Task ChangePage(int value) { page = value; return Task.CompletedTask; } }
