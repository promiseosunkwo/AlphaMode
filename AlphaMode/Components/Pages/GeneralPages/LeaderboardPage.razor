@page "/leaderboard"
@rendermode InteractiveServer
@using AlphaMode.Application.FootballRankings.DTOs
@using AlphaMode.Application.FootballRankings.Interfaces
@using AlphaMode.Application.Games.DTOs
@using AlphaMode.Application.Games.Interfaces
@using AlphaMode.Components.Sections.Shared
@inject IRankingQueryService RankingService
@inject IGameService GameService

<PageTitle>Leaderboard | AlphaMode</PageTitle><div class="alpha-page"><Navbar /><main class="public-main"><section class="public-hero"><div><span>Competitive Elo</span><h1>Global leaderboard</h1><p>Verified, game-specific rankings from completed competitive tournament matches.</p></div></section><section class="public-section"><div class="public-toolbar"><select class="public-select" value="@gameId" @onchange="ChangeGameAsync">@foreach (var game in games) { <option value="@game.Id">@game.Name · @game.Platform</option> }</select><input class="public-search" placeholder="Search player" @bind="search" @bind:event="oninput" /></div>
@if (isLoading) { <ContentSkeleton Rows="9" /> } else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> } else if (!Filtered.Any()) { <EmptyState Title="No ranked players" Message="This leaderboard will populate after ranked tournament results are recorded." /> } else { <div class="public-ranking"><div class="public-ranking-head"><span>Rank</span><span>Player</span><span>Record</span><span>Matches</span><span>Elo</span></div>@foreach (var player in Filtered) { <div class="public-ranking-row"><strong>#@player.Position</strong><div><span>@Initials(player.GamerTag)</span><b>@player.GamerTag</b></div><span>@player.Wins W · @player.Draws D · @player.Losses L</span><span>@player.MatchesPlayed</span><b>@player.EloRating.ToString("0")</b></div> }</div> }
</section></main><Footer /></div>
@code { private IReadOnlyList<GameDto> games = []; private IReadOnlyList<LeaderboardEntryDto> rankings = []; private Guid gameId; private string search = ""; private bool isLoading; private string? errorMessage; private IEnumerable<LeaderboardEntryDto> Filtered => rankings.Where(x => string.IsNullOrWhiteSpace(search) || x.GamerTag.Contains(search, StringComparison.OrdinalIgnoreCase)); protected override async Task OnInitializedAsync() { var result = await GameService.GetActiveAsync(); if (!result.Succeeded) { errorMessage = result.Error; return; } games = result.Value ?? []; gameId = games.FirstOrDefault()?.Id ?? Guid.Empty; await LoadAsync(); } private async Task ChangeGameAsync(ChangeEventArgs args) { if (Guid.TryParse(args.Value?.ToString(), out var id)) { gameId = id; await LoadAsync(); } } private async Task LoadAsync() { if (gameId == Guid.Empty) return; isLoading = true; errorMessage = null; try { var result = await RankingService.GetLeaderboardAsync(gameId, 200); if (!result.Succeeded) { errorMessage = result.Error; return; } rankings = result.Value ?? []; } finally { isLoading = false; } } private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0]))); }

