@page "/tournaments"
@rendermode InteractiveServer
@using AlphaMode.Application.Tournaments.DTOs
@using AlphaMode.Application.Tournaments.Interfaces
@using AlphaMode.Components.Sections.Shared
@using AlphaMode.Domain.Enums
@inject ITournamentService TournamentService

<PageTitle>Tournaments | AlphaMode</PageTitle>
@* This directory replaces the former demo tournament lists with published database records. *@
<div class="alpha-page"><Navbar /><main class="public-main"><section class="public-hero"><div><span>Competition hub</span><h1>Find your next tournament</h1><p>Discover open registrations, follow live competitions, and revisit completed events.</p></div></section>
<section class="public-section"><div class="public-toolbar"><div class="public-tabs">@foreach (var value in new[] { "All", "Open", "Upcoming", "Live", "Completed" }) { <button class="@(filter == value ? "active" : null)" @onclick="() => filter = value">@value</button> }</div><input class="public-search" placeholder="Search tournaments or games" @bind="search" @bind:event="oninput" /></div>
@if (isLoading) { <ContentSkeleton Rows="8" /> } else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> } else if (!Filtered.Any()) { <EmptyState Title="No tournaments found" Message="Try another filter or check back when a new competition is published." /> } else { <div class="public-card-grid">@foreach (var item in Filtered) { <article class="public-tournament-card"><div class="public-card-cover" style="@Cover(item)"><span>@item.GameName</span><b>@item.Status</b></div><div class="public-card-body"><small>@item.Format · @item.RegisteredPlayers/@item.MaxPlayers players</small><h2>@item.Name</h2><p>@Truncate(item.Description, 110)</p><dl><div><dt>Starts</dt><dd>@item.StartDate.ToLocalTime().ToString("dd MMM yyyy")</dd></div><div><dt>Entry</dt><dd>@(item.EntryFee == 0 ? "Free" : item.EntryFee.ToString("N0"))</dd></div></dl><a class="public-button" href="/tournaments/@item.Slug">View tournament <span>→</span></a></div></article> }</div> }
</section></main><Footer /></div>

@code {
    private IReadOnlyList<TournamentDto> tournaments = []; private string filter = "All"; private string search = ""; private bool isLoading; private string? errorMessage;
    private IEnumerable<TournamentDto> Filtered => tournaments.Where(x => x.Status is not TournamentStatus.Draft and not TournamentStatus.Cancelled).Where(x => filter switch { "Open" => x.Status == TournamentStatus.RegistrationOpen, "Upcoming" => x.Status == TournamentStatus.Upcoming, "Live" => x.Status == TournamentStatus.Live, "Completed" => x.Status == TournamentStatus.Completed, _ => true }).Where(x => string.IsNullOrWhiteSpace(search) || x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || x.GameName.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Status == TournamentStatus.Live ? 0 : x.Status == TournamentStatus.RegistrationOpen ? 1 : 2).ThenBy(x => x.StartDate);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { isLoading = true; errorMessage = null; try { var result = await TournamentService.GetAllAsync(); if (!result.Succeeded) { errorMessage = result.Error; return; } tournaments = result.Value ?? []; } finally { isLoading = false; } }
    private static string Cover(TournamentDto x) => string.IsNullOrWhiteSpace(x.ImageUrl) ? "" : $"background-image:linear-gradient(180deg,transparent,#10131b),url('{x.ImageUrl}')";
    private static string Truncate(string value, int max) => string.IsNullOrWhiteSpace(value) ? "Tournament details and competition information." : value.Length <= max ? value : $"{value[..max]}…";
}

