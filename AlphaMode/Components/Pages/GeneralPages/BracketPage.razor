@page "/tournaments/{TournamentId:guid}/bracket"
@rendermode InteractiveServer
@using AlphaMode.Application.TournamentFixtures.DTOs
@using AlphaMode.Application.TournamentFixtures.Interfaces
@using AlphaMode.Components.Sections.Shared
@inject ITournamentFixtureService FixtureService

<PageTitle>Tournament bracket | AlphaMode</PageTitle><div class="alpha-page"><Navbar /><main class="public-main"><section class="public-hero"><div><span>Competition bracket</span><h1>@(fixture?.TournamentName ?? "Tournament bracket")</h1><p>Round-by-round progression from published tournament fixtures.</p></div></section><section class="public-section">
@if (isLoading) { <ContentSkeleton Rows="8" /> } else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> } else if (fixture?.FixturesGenerated != true) { <EmptyState Title="Bracket not published" Message="The organizer has not generated this tournament bracket yet." /> } else { <div class="public-bracket">@foreach (var round in fixture.Rounds) { <section><header><span>Round @round.RoundNumber</span><h2>@round.Name</h2></header>@foreach (var match in round.Matches) { <article><div class="@(match.WinnerId == match.PlayerOneId ? "winner" : null)"><span>@match.PlayerOneName</span><b>@(match.PlayerOneScore?.ToString() ?? "—")</b></div><div class="@(match.WinnerId == match.PlayerTwoId ? "winner" : null)"><span>@match.PlayerTwoName</span><b>@(match.PlayerTwoScore?.ToString() ?? "—")</b></div><small>@match.Status</small></article> }</section> }</div> }
</section></main><Footer /></div>
@code { [Parameter] public Guid TournamentId { get; set; } private TournamentFixtureDto? fixture; private bool isLoading; private string? errorMessage; protected override Task OnParametersSetAsync() => LoadAsync(); private async Task LoadAsync() { isLoading = true; errorMessage = null; try { var result = await FixtureService.GetAsync(TournamentId); if (!result.Succeeded) { errorMessage = result.Error; return; } fixture = result.Value; } finally { isLoading = false; } } }

