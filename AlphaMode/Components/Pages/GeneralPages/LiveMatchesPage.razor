@page "/live-matches"
@rendermode InteractiveServer
@using AlphaMode.Application.Dashboards.DTOs
@using AlphaMode.Application.Dashboards.Interfaces
@using AlphaMode.Components.Sections.Shared
@using AlphaMode.Domain.Enums
@inject IDashboardQueryService DashboardService

<PageTitle>Live matches | AlphaMode</PageTitle><div class="alpha-page"><Navbar /><main class="public-main"><section class="public-hero"><div><span>Live arena</span><h1>Matches happening now</h1><p>Follow current tournament scores and recently completed results.</p></div><a class="public-button secondary" href="/upcoming-matches">Upcoming fixtures</a></section><section class="public-section">
@if (isLoading) { <ContentSkeleton Rows="6" /> } else if (!string.IsNullOrWhiteSpace(errorMessage)) { <ErrorState Message="@errorMessage" OnRetry="LoadAsync" /> } else if (!Visible.Any()) { <EmptyState Title="No live matches" Message="Live and recently completed tournament matches will appear here." /> } else { <div class="public-live-grid">@foreach (var match in Visible) { <article class="public-live-card"><header><span class="public-pill @(match.Status == MatchStatus.Live ? "live" : null)">@match.Status</span><small>@match.CompetitionName · R@match.RoundNumber</small></header><div class="public-score"><strong>@match.PlayerOneName</strong><b>@Score(match)</b><strong>@match.PlayerTwoName</strong></div><footer><span>@match.GameName</span><time>@(match.ScheduledAt?.ToLocalTime().ToString("dd MMM · HH:mm") ?? "Time TBC")</time></footer></article> }</div> }
</section></main><Footer /></div>
@code { private IReadOnlyList<UserMatchDto> matches = []; private bool isLoading; private string? errorMessage; private IEnumerable<UserMatchDto> Visible => matches.Where(x => x.Status is MatchStatus.Live or MatchStatus.Completed).OrderBy(x => x.Status == MatchStatus.Live ? 0 : 1).ThenByDescending(x => x.ScheduledAt).Take(24); protected override Task OnInitializedAsync() => LoadAsync(); private async Task LoadAsync() { isLoading = true; errorMessage = null; try { var result = await DashboardService.GetPublicTournamentMatchesAsync(); if (!result.Succeeded) { errorMessage = result.Error; return; } matches = result.Value ?? []; } finally { isLoading = false; } } private static string Score(UserMatchDto x) => x.PlayerOneScore.HasValue ? $"{x.PlayerOneScore} – {x.PlayerTwoScore}" : "VS"; }

