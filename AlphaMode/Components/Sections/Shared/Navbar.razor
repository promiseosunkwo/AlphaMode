@using AlphaMode.Application.Common
<!-- NAVBAR -->
<header class="alpha-navbar">
    <div class="alpha-container nav-content">
        <a class="brand" href="/">
            <span class="brand-mark">A</span>
            <span>AlphaMode</span>
        </a>

        <nav class="nav-links">
            <a href="/tournaments">Tournaments</a>
            <a href="/upcoming-matches">Fixtures</a>
            <a href="/live-matches">Live</a>
            <a href="/leaderboard">Leaderboard</a>
            <a href="/#contact">Contact</a>
        </nav>

        <div class="nav-actions">
            <AuthorizeView>
                <Authorized Context="authContext">
                    @{
                        var dashboardUrl = authContext.User.IsInRole(Roles.Admin) ? "/admin/dashboard": "/dashboard";
                    }

                    <a class="btn btn-outline" href="@dashboardUrl">Dashboard</a>

                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />

                        @* An empty ReturnUrl previously produced an unreliable redirect. The home route is
                           explicit so logout always lands on a valid public page. *@
                        <input type="hidden" name="ReturnUrl" value="/" />

                        <button type="submit" class="btn btn-primary">Logout</button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <a class="btn btn-outline" href="/login">Login</a>

                    <a class="btn btn-primary" href="/register">Join Now</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

