@using AlphaMode.Application.Tournaments.DTOs
<section id="tournaments" class="section dark-section"><div class="alpha-container"><div class="section-heading"><p class="eyebrow">Upcoming Events</p><h2>Join A Tournament</h2></div>
@if (Tournaments.Count == 0) { <p>No published tournaments are available yet.</p> } else { <div class="tournament-grid">@foreach (var tournament in Tournaments.Take(3)) { <div class="tournament-card"><div class="card-top"><span>@tournament.GameName</span><span>@tournament.Status</span></div><h3>@tournament.Name</h3><p>@tournament.StartDate.ToLocalTime().ToString("dd MMM yyyy")</p><div class="tournament-info"><div><span>Players</span><strong>@tournament.RegisteredPlayers / @tournament.MaxPlayers</strong></div><div><span>Entry</span><strong>@(tournament.EntryFee == 0 ? "Free" : tournament.EntryFee.ToString("N0"))</strong></div><div><span>Format</span><strong>@tournament.Format</strong></div></div><a href="/tournaments/@tournament.Slug" class="btn btn-outline w-100">View Details</a></div> }</div> }
</div></section>
@code { [Parameter] public IReadOnlyList<TournamentDto> Tournaments { get; set; } = []; }
