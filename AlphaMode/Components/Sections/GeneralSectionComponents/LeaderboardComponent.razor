@using AlphaMode.Application.FootballRankings.DTOs
<section id="leaderboard" class="section dark-section"><div class="alpha-container"><div class="section-heading"><p class="eyebrow">Top Players</p><h2>@GameName Leaderboard</h2></div>
@if (Players.Count == 0) { <p>Rankings will appear after competitive matches are completed.</p> } else { <div class="leaderboard"><div class="leader-row header"><span>Rank</span><span>Player</span><span>Record</span><span>Matches</span><span>Elo</span></div>@foreach (var player in Players.Take(5)) { <div class="leader-row"><span>#@player.Position</span><span>@player.GamerTag</span><span>@player.Wins W · @player.Draws D · @player.Losses L</span><span>@player.MatchesPlayed</span><span>@player.EloRating.ToString("0")</span></div> }</div> }
</div></section>
@code { [Parameter] public IReadOnlyList<LeaderboardEntryDto> Players { get; set; } = []; [Parameter] public string GameName { get; set; } = "Global"; }
