@using AlphaMode.Application.Games.DTOs
<!-- Active games are supplied by the database-backed landing page. -->
<section id="games" class="section"><div class="alpha-container"><div class="section-heading"><p class="eyebrow">Choose Your Battle</p><h2>Featured Games</h2></div>
@if (Games.Count == 0) { <p>No active games are available yet.</p> } else { <div class="game-grid">@foreach (var game in Games.Take(4)) { <div class="game-card"><div class="game-icon">🎮</div><h3>@game.Name</h3><p>@game.Platform · @game.TournamentCount tournament@(game.TournamentCount == 1 ? "" : "s")</p></div> }</div> }
</div></section>
@code { [Parameter] public IReadOnlyList<GameDto> Games { get; set; } = []; }
