@page "/dashboard"

<div class="alpha-page">

    <section class="section">
        <div class="alpha-container">

            <div class="section-heading">
                <p class="eyebrow">Player Dashboard</p>
                <h2>Welcome Back, Player</h2>
                <p class="subtext">Track your performance, matches, and tournaments</p>
            </div>

            <!-- STATS CARDS -->
            <div class="dashboard-grid">

                <div class="dash-card">
                    <h3>Wins</h3>
                    <span>24</span>
                </div>

                <div class="dash-card">
                    <h3>Losses</h3>
                    <span>6</span>
                </div>

                <div class="dash-card">
                    <h3>Rank</h3>
                    <span>#3</span>
                </div>

                <div class="dash-card highlight">
                    <h3>Points</h3>
                    <span>860</span>
                </div>

            </div>

            <!-- QUICK ACTIONS -->
            <div class="dashboard-actions">

                <button class="btn btn-primary">Join Tournament</button>
                <button class="btn btn-outline">View Matches</button>
                <button class="btn btn-outline">Leaderboard</button>

            </div>

            <!-- RECENT MATCHES -->
            <div class="section-heading small">
                <h3>Recent Matches</h3>
            </div>

            <div class="recent-matches">

                <div class="match-item win">
                    <span>ToyinFC vs ShadowX</span>
                    <b>3 - 1</b>
                    <small>Win</small>
                </div>

                <div class="match-item loss">
                    <span>ToyinFC vs NeoBlade</span>
                    <b>1 - 2</b>
                    <small>Loss</small>
                </div>

            </div>

        </div>
    </section>

</div>