@page "/dashboard"
@layout AlphaMode.Components.Layout.UserLayout
@using AlphaMode.Data
@using AlphaMode.Components.Sections.UserSectionComponents

<PageTitle>Player overview | AlphaMode</PageTitle>
<PortalPageHeader Eyebrow="Dashboard" Title="Welcome back, @Profile.GamerTag" Description="Your competitive activity, progress, and next steps in one place.">
    <Actions><a class="portal-button primary" href="dashboard/tournaments">Find a tournament <span>→</span></a></Actions>
</PortalPageHeader>

<section class="profile-hero">
    <div class="profile-avatar">@Profile.Initials<span></span></div>
    <div class="profile-identity"><small>Level @Profile.Level player</small><h2>@Profile.DisplayName</h2><p>@@@Profile.GamerTag · @Profile.FavouriteGame · @Profile.Region</p></div>
    <div class="level-progress"><div><span>Level progress</span><strong>@Profile.LevelProgress%</strong></div><progress value="@Profile.LevelProgress" max="100">@Profile.LevelProgress%</progress><small>@((100 - Profile.LevelProgress) * 20) XP to level @(Profile.Level + 1)</small></div>
</section>

<section class="portal-stats-grid" aria-label="Performance summary">
    <PortalStatCard Icon="◉" Label="Matches played" Value="@Stats.Matches.ToString()" Detail="4 this month" />
    <PortalStatCard Icon="✓" Label="Wins" Value="@Stats.Wins.ToString()" Detail="@Stats.WinRate% win rate" Accent="positive" />
    <PortalStatCard Icon="↗" Label="Global rank" Value="#@Stats.CurrentRank" Detail="Up 3 places" Accent="primary" />
    <PortalStatCard Icon="◆" Label="Ranking points" Value="@Stats.Points.ToString("N0")" Detail="Best rank #@Stats.BestRank" />
</section>

<div class="portal-dashboard-grid">
    <section class="portal-panel span-two">
        <div class="portal-section-heading"><div><span>Schedule</span><h2>Upcoming matches</h2></div><a href="dashboard/matches">View all</a></div>
        <div class="match-card-grid">@foreach (var match in Matches.Where(x => x.Status == "Upcoming").Take(2)) { <PlayerMatchCard Match="match" /> }</div>
    </section>
    <section class="portal-panel ranking-preview">
        <div class="portal-section-heading"><div><span>Leaderboard</span><h2>Your position</h2></div><a href="dashboard/ranking">Full ranking</a></div>
        <div class="rank-orbit"><strong>#@Stats.CurrentRank</strong><span>Global</span></div><h3>Top 8%</h3><p>You are 140 points away from the next position.</p><progress value="72" max="100">72%</progress>
    </section>
    <section class="portal-panel span-two">
        <div class="portal-section-heading"><div><span>Competitions</span><h2>Your tournaments</h2></div><a href="dashboard/tournaments">Browse all</a></div>
        @foreach (var tournament in Tournaments.Where(x => x.IsJoined)) { <div class="compact-tournament"><span class="game-tile">FC</span><div><strong>@tournament.Name</strong><small>@tournament.Game · @tournament.StartsAt.ToString("dd MMM")</small></div><span class="portal-status open">Registered</span><a href="dashboard/fixtures">Fixtures →</a></div> }
    </section>
    <section class="portal-panel">
        <div class="portal-section-heading"><div><span>Inbox</span><h2>Notifications</h2></div><a href="dashboard/notifications">View all</a></div>
        <div class="notification-preview">@foreach (var item in Notifications.Where(x => !x.IsRead).Take(3)) { <a href="@item.Link"><span></span><div><strong>@item.Title</strong><small>@item.Message</small></div></a> }</div>
    </section>
</div>

@code {
    // Pages consume one source today; an API-backed query can replace it later.
    private static AlphaMode.ViewModels.PlayerProfileViewModel Profile => UserPortalSampleData.Profile;
    private static AlphaMode.ViewModels.PlayerStatsViewModel Stats => UserPortalSampleData.Stats;
    private static IReadOnlyList<AlphaMode.ViewModels.PlayerMatchViewModel> Matches => UserPortalSampleData.Matches;
    private static IReadOnlyList<AlphaMode.ViewModels.PlayerTournamentViewModel> Tournaments => UserPortalSampleData.Tournaments;
    private static IReadOnlyList<AlphaMode.ViewModels.PlayerNotificationViewModel> Notifications => UserPortalSampleData.Notifications;
}

