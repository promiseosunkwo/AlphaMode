@page "/dashboard/matches"
@layout AlphaMode.Components.Layout.UserLayout
@using AlphaMode.Data
@using AlphaMode.Components.Sections.UserSectionComponents
<PageTitle>My matches | AlphaMode</PageTitle>
<PortalPageHeader Eyebrow="Competition" Title="My matches" Description="Review results and prepare for everything coming next." />
<div class="portal-filter-row"><button class="active">All matches <span>@Matches.Count</span></button><button>Upcoming</button><button>Completed</button></div>
<section class="match-card-grid three">@foreach (var match in Matches) { <PlayerMatchCard Match="match" /> }</section>
@code { private static IReadOnlyList<AlphaMode.ViewModels.PlayerMatchViewModel> Matches => UserPortalSampleData.Matches; }

