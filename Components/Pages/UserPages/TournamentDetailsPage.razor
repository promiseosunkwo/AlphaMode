            MatchStatus.Pending => "Pending",
            MatchStatus.Scheduled => "Scheduled",
            MatchStatus.Live => "Live",
            MatchStatus.Completed => "Completed",
            _ => status.ToString()
        };
    }

    private static string GetMatchStatusClass(
    MatchStatus status)
    {
        return status switch
        {
            MatchStatus.Live =>
                "portal-status danger",

            MatchStatus.Completed =>
                "portal-status open",

            MatchStatus.Scheduled =>
                "portal-status pending",

            _ =>
                "portal-status"
        };
    }

    private static string GetMatchLabel(
    FixtureMatchDto match)
    {
        if (match.MatchWeek.HasValue)
        {
            return $"Matchweek {match.MatchWeek.Value}";
        }

        return $"Round {match.RoundNumber}";
    }

    private static string GetWinnerName(
    FixtureMatchDto match)
    {
        if (!match.WinnerId.HasValue)
            return string.Empty;

        if (match.WinnerId == match.PlayerOneId)
            return match.PlayerOneName;

        if (match.WinnerId == match.PlayerTwoId)
            return match.PlayerTwoName;

        return string.Empty;
    }

    private static string GetPlayerMatchClass(FixtureMatchDto match, Guid? playerId)
    {
        const string baseClass = "competition-fixture-player";

        if (match.Status != MatchStatus.Completed || !match.WinnerId.HasValue || !playerId.HasValue)
        {
            return baseClass;
        }

        return match.WinnerId == playerId
            ? $"{baseClass} winner"
            : baseClass;
    }

    private static string GetMatchKey(FixtureMatchDto match)
    {
        if (match.MatchId.HasValue)
        {
            return match.MatchId.Value.ToString();
        }

        return $"{match.RoundNumber}-" +
               $"{match.MatchWeek}-" +
               $"{match.PlayerOneId}-" +
               $"{match.PlayerTwoId}";
    }
