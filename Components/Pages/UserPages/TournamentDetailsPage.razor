@page "/dashboard/my-tournaments/{TournamentId:guid}"

@layout AlphaMode.Components.Layout.UserLayout
@rendermode InteractiveServer

@using System.Security.Claims
@using AlphaMode.Application.TournamentFixtures.DTOs
@using AlphaMode.Application.TournamentRegistrations.DTOs
@using AlphaMode.Application.TournamentRegistrations.Interfaces
@using AlphaMode.Application.TournamentStandings.DTOs
@using AlphaMode.Domain.Entities
@using AlphaMode.Domain.Enums
@using AlphaMode.Components.Sections.UserSectionComponents
@using AlphaMode.Services
@using AlphaMode.Application.TournamentStandings.Interfaces
@using AlphaMode.Application.TournamentFixtures.Interfaces
@using AlphaMode.Application.PlayerTournamentRegistrations.DTOs
@using AlphaMode.Application.PlayerTournamentRegistrations.Interfaces
@using AlphaMode.Components.Shared.ConfirmDialog

@inject ITournamentFixtureService FixtureService
@inject ITournamentStandingsQueryService LeagueStandingsService
@inject ITournamentRegistrationService RegistrationService
@inject ITournamentPlayerRegistrationService PlayerRegistrationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>
    @(tournament is null ? "Tournament | AlphaMode" : $"{tournament.TournamentName} | AlphaMode")
</PageTitle>


@if (isLoading)
{
    <div class="portal-empty-state">
        Loading tournament...
    </div>
}
else if (tournament is null)
{
    <div class="portal-empty-state">

        <h2>Tournament unavailable</h2>

        <p>
            @errorMessage
        </p>

        <button type="button" class="portal-button primary"
                @onclick="BackToMyTournaments">
            Back to my tournaments
        </button>

    </div>
}
else
{
    <section class="competition-centre">

        @* ============================================= *@
        @* HERO                                          *@
        @* ============================================= *@

        <header class="competition-hero" style="@GetHeroStyle()">

            <div class="competition-hero-overlay">

                <button type="button" class="competition-back"
                        @onclick="BackToMyTournaments">
                    ← My tournaments
                </button>


                <div class="competition-hero-content">

                    <div>

                        <span class="competition-game">
                            @tournament.GameName
                        </span>

                        <h1>
                            @tournament.TournamentName
                        </h1>

                        <div class="competition-hero-meta">

                            <span>
                                @FormatTournamentFormat(tournament.Format)
                        </span>

                        <span>•</span>

                        <span>
                            @tournament.RegisteredPlayers/@tournament.MaxPlayers
                            players
                        </span>

                        <span>•</span>

                        <span>
                            @tournament.StartDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </span>

                    </div>

                </div>


                <span class="@GetRegistrationStatusClass()">
                    @GetRegistrationStatusText()
                </span>

            </div>

        </div>

    </header>


    @* ============================================= *@
    @* TABS                                          *@
    @* ============================================= *@

    <nav class="competition-tabs">

        <button type="button"
                class="@GetTabClass(CompetitionTab.Overview)"
                @onclick="() => SelectTab(CompetitionTab.Overview)">
            Overview
        </button>

        <button type="button"
                class="@GetTabClass(CompetitionTab.Players)"
                @onclick="() => SelectTab(CompetitionTab.Players)">
            Players
            <span>
                @tournament.RegisteredPlayers
            </span>
        </button>

        <button type="button"
                class="@GetTabClass(CompetitionTab.Fixtures)"
                @onclick="() => SelectTab(CompetitionTab.Fixtures)">
            Fixtures
        </button>

        <button type="button"
                class="@GetTabClass(CompetitionTab.Standings)"
                @onclick="() => SelectTab(CompetitionTab.Standings)">
            Standings
        </button>

    </nav>


    @* ============================================= *@
    @* TAB CONTENT                                   *@
    @* ============================================= *@

    <div class="competition-content">

        @if (selectedTab == CompetitionTab.Overview)
            {
                <div class="competition-overview">

                    <div class="competition-main-column">

                        <section class="competition-panel">

                            <div class="competition-panel-heading">
                                <div>
                                    <span class="competition-eyebrow">
                                        Your participation
                                    </span>

                                    <h2>Tournament journey</h2>
                                </div>

                                <span class="@GetRegistrationStatusClass()">
                                    @GetRegistrationStatusText()
                                </span>
                            </div>


                            <div class="competition-journey">

                                <div class="journey-step complete">
                                    <span>✓</span>

                                    <div>
                                        <strong>Joined</strong>
                                        <small>Tournament entry created</small>
                                    </div>
                                </div>


                                <div class="@GetJourneyLineClass(2)"></div>


                                <div class="@GetJourneyStepClass(2)">
                                    <span>
                                        @(HasConfirmedRegistration() ? "✓" : "2")
                                    </span>

                                    <div>
                                        <strong>Registered</strong>

                                        <small>
                                            @(HasConfirmedRegistration()
                                            ? "Place confirmed"
                                            : "Awaiting confirmation")
                                        </small>
                                    </div>
                                </div>


                                <div class="@GetJourneyLineClass(3)"></div>


                                <div class="@GetJourneyStepClass(3)">
                                    <span>
                                        @(tournament.RegistrationStatus == TournamentRegistrationStatus.CheckedIn
                                                                        ? "✓"
                                                                        : "3")
                            </span>

                                    <div>
                                        <strong>Check-in</strong>
                                        <small>@GetCheckInShortText()</small>
                                    </div>
                                </div>

                            </div>


                    @if (tournament.RegistrationStatus == TournamentRegistrationStatus.PendingPayment)
                            {
                                <div class="competition-action-box warning">

                                    <div>
                                        <strong>Payment required</strong>

                                        <p>
                                            Your place will be confirmed when your
                                            tournament entry payment is completed.
                                        </p>
                                    </div>

                                    <button type="button"
                                            class="portal-button primary"
                                            @onclick="ContinuePayment">
                                        Continue payment
                                    </button>

                                </div>
                            }
                            else if (CanCheckIn())
                            {
                                <div class="competition-action-box success">

                                    <div>
                                        <strong>Check-in is open</strong>

                                        <p>
                                            Confirm that you're ready to participate
                                            in this tournament.
                                        </p>
                                    </div>

                                    <button type="button"
                                            class="portal-button primary"
                                            disabled="@isCheckingIn"
                                            @onclick="CheckInAsync">

                                        @(isCheckingIn
                                        ? "Checking in..."
                                        : "Check in now")

                        </button>

                                </div>
                        }
                            else if (tournament.RegistrationStatus == TournamentRegistrationStatus.Registered)
                            {
                                <div class="competition-action-box">

                                    <div>
                                        <strong>You're registered</strong>
                                        <p>@GetCheckInMessage()</p>
                                    </div>

                                </div>
                            }
                            else if (tournament.RegistrationStatus == TournamentRegistrationStatus.CheckedIn)
                            {
                                <div class="competition-action-box success">

                                    <div>
                                        <strong>You're checked in ✓</strong>

                                        <p>
                                            You're ready to compete. Fixtures will
                                            appear here when they are available.
                                        </p>
                                    </div>

                                </div>
                            }

                            @if (registrationAvailability?.CanWithdraw == true)
                            {
                                <div class="competition-withdraw-action">
                                    <button type="button"
                                            class="portal-button subtle"
                                            disabled="@isWithdrawing"
                                            @onclick="() => showWithdrawConfirmation = true">
                                        Withdraw from tournament
                                    </button>
                                </div>
                            }

                        </section>


                        <section class="competition-panel">

                            <div class="competition-panel-heading">
                                <div>
                                    <span class="competition-eyebrow">
                                        About
                                    </span>

                                    <h2>Tournament information</h2>
                                </div>
                            </div>


                            @if (string.IsNullOrWhiteSpace(tournament.Description))
                            {
                                <p class="competition-muted">
                                    No tournament description has been provided.
                                </p>
                            }
                            else
                            {
                                <p class="competition-description">
                                    @tournament.Description
                                </p>
                            }

                </section>

            </div>


            <aside class="competition-side-column">

                <section class="competition-panel">

                    <span class="competition-eyebrow">
                        Tournament
                    </span>

                    <div class="competition-info-grid">

                        <div>
                            <small>Game</small>
                            <strong>@tournament.GameName</strong>
                        </div>

                        <div>
                            <small>Format</small>
                            <strong>
                                @FormatTournamentFormat(tournament.Format)
                            </strong>
                        </div>

                        <div>
                            <small>Starts</small>

                            <strong>
                                @tournament.StartDate.ToLocalTime().ToString("dd MMM yyyy")
                            </strong>

                            <span>
                                @tournament.StartDate.ToLocalTime().ToString("HH:mm")
                            </span>
                        </div>

                        <div>
                            <small>Ends</small>

                            <strong>
                                @tournament.EndDate.ToLocalTime().ToString("dd MMM yyyy")
                            </strong>

                            <span>
                                @tournament.EndDate.ToLocalTime().ToString("HH:mm")
                            </span>
                        </div>

                        <div>
                            <small>Entry fee</small>

                            <strong>
                                @(tournament.EntryFee <= 0
                                ? "Free"
                                : FormatMoney(
                                tournament.EntryFee,
                                "NGN"))
                            </strong>
                        </div>

                                <div>
                                    <small>Prize pool</small>

                                    <strong>
                                        @FormatMoney(
                                    tournament.PrizePool,
                                    tournament.Currency)
                            </strong>
                        </div>

                    </div>

                </section>


                <section class="competition-panel">

                    <span class="competition-eyebrow">
                        Players
                    </span>

                    <div class="competition-player-summary">

                        <strong>
                            @tournament.RegisteredPlayers /
                            @tournament.MaxPlayers
                        </strong>

                        <span>confirmed players</span>

                        <progress value="@tournament.RegisteredPlayers"
                                  max="@tournament.MaxPlayers">
                        </progress>

                        <div class="competition-checkin-count">
                            <span>Checked in</span>
                            <strong>@tournament.CheckedInPlayers</strong>
                        </div>

                    </div>

                </section>


                <section class="competition-panel">

                    <span class="competition-eyebrow">
                        Scoring
                    </span>

                    <div class="competition-score-rules">

                        <div>
                            <small>Win</small>
                            <strong>@tournament.PointsForWin pts</strong>
                        </div>

                        <div>
                            <small>Draw</small>
                            <strong>@tournament.PointsForDraw pts</strong>
                        </div>

                        <div>
                            <small>Loss</small>
                            <strong>@tournament.PointsForLoss pts</strong>
                        </div>

                    </div>

                    <div class="competition-legs">
                        <span>Legs</span>
                        <strong>@tournament.Legs</strong>
                    </div>

                </section>

            </aside>

        </div>
            }
            else if (selectedTab == CompetitionTab.Players)
            {
                <section class="competition-panel">

                    <div class="competition-panel-heading">

                        <div>
                            <span class="competition-eyebrow">
                                Participants
                            </span>

                            <h2>Tournament players</h2>
                        </div>

                        <span class="competition-count">
                            @tournament.Participants.Count players
                        </span>

                    </div>


                    @if (!tournament.Participants.Any())
                    {
                        <div class="portal-empty-state">
                            No confirmed players yet.
                        </div>
                    }
                    else
                    {
                        <div class="competition-player-list">

                            @for (var i = 0; i < tournament.Participants.Count; i++)
                            {
                                var participant = tournament.Participants[i];

                                <div class="competition-player-row"
                                     @key="participant.PlayerId">

                                    <span class="competition-player-position">
                                        @(i + 1)
                                    </span>


                                    <div class="competition-avatar">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                participant.AvatarUrl))
                                        {
                                            <img src="@participant.AvatarUrl"
                                                 alt="@participant.GamerTag" />
                                        }
                                        else
                                        {
                                            <span>
                                                @GetInitials(
                                                participant.GamerTag)
                        </span>
                                        }

                            </div>


                            <div class="competition-player-name">

                                <strong>
                                    @participant.GamerTag
                                </strong>

                                <span>
                                    @participant.RankingPoints
                                    ranking points
                                </span>

                            </div>


                            <div class="competition-player-state">

                                @if (participant.Status == TournamentRegistrationStatus.CheckedIn)
                                {
                                    <span class="portal-status open">
                                        Checked in
                                    </span>
                                }
                                else
                                {
                                    <span class="portal-status">
                                        Registered
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

        </section>

         }else if (selectedTab == CompetitionTab.Fixtures)
         {
            <section class="competition-panel">

                <div class="competition-panel-heading">

                    <div>
                        <span class="competition-eyebrow">
                            Match schedule
                        </span>

                        <h2>Tournament fixtures</h2>
                    </div>

                    @if (fixtures is not null && fixtures.FixturesGenerated)
                    {
                        <span class="competition-count">
                            @fixtures.Rounds.Sum(x => x.Matches.Count) matches
                        </span>
                    }

                </div>


                @if (isFixturesLoading)
                {
                    <div class="portal-empty-state">
                        Loading fixtures...
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(fixturesError))
                {
                    <div class="portal-empty-state">

                        <h3>Fixtures unavailable</h3>

                        <p>@fixturesError</p>

                        <button type="button"
                                class="portal-button subtle"
                                @onclick="LoadFixturesAsync">
                            Try again
                        </button>

                    </div>
                }
                else if (fixtures is null || !fixtures.FixturesGenerated || !fixtures.Rounds.Any())
                {
                    <div class="competition-feature-empty">

                        <div class="competition-feature-icon">
                            ⚔
                        </div>

                        <h2>Fixtures aren't available yet</h2>

                        <p>
                            Match fixtures will appear here once the
                            tournament organiser generates them.
                        </p>

                        <span>
                            @tournament.CheckedInPlayers
                            players currently checked in
                        </span>

                        </div>
                    }
                    ////////// tournament bracket //////////////
                    else if (fixtures.Format == TournamentFormat.SingleElimination)
                    {
                        <SingleEliminationBracket Fixtures="@fixtures" />
                    }
                    else{
                        <div class="competition-fixture-rounds">

                        @foreach (var round in fixtures.Rounds)
                        {
                            <section class="competition-fixture-round"
                                     @key="round.RoundNumber">

                                <div class="competition-fixture-round-heading">

                                    <div>
                                        <span>
                                            Round @round.RoundNumber
                                        </span>

                                        <h3>@round.Name</h3>
                                    </div>

                                    <span class="competition-count">
                                        @round.Matches.Count matches
                                    </span>

                                </div>


                                <div class="competition-fixture-list">

                                    @foreach (var match in round.Matches)
                                    {
                                        <article class="competition-fixture-card"
                                                 @key="GetMatchKey(match)">

                                            <div class="competition-fixture-meta">

                                                <span>
                                                    @GetMatchLabel(match)
                                                </span>

                                                <span class="@GetMatchStatusClass(match.Status)">
                                                    @GetMatchStatusText(match.Status)
                                                </span>

                                            </div>


                                            <div class="competition-fixture-players">

                                                <div class="@GetPlayerMatchClass(
                                                   match,
                                                   match.PlayerOneId)">

                                    <span class="competition-avatar small">
                                        @GetInitials(match.PlayerOneName)
                                    </span>

                                        <strong>
                                            @match.PlayerOneName
                                        </strong>

                                    @if (match.HasScore)
                                    {
                                        <span class="competition-fixture-score">
                                            @match.PlayerOneScore
                                        </span>
                                    }

                                </div>


                                <div class="competition-fixture-versus">

                                    @if (match.HasScore)
                                    {
                                        <span>—</span>
                                    }
                                    else
                                    {
                                        <span>VS</span>
                                    }

                                </div>


                            <div class="@GetPlayerMatchClass(match, match.PlayerTwoId)">

                            <span class="competition-avatar small">
                                @GetInitials(match.PlayerTwoName)
                            </span>

                            <strong>
                                @match.PlayerTwoName
                            </strong>

                            @if (match.HasScore)
                            {
                                <span class="competition-fixture-score">
                                    @match.PlayerTwoScore
                                </span>
                            }

                            </div>

                                </div>


                        <div class="competition-fixture-footer">

                            @if (match.ScheduledAt.HasValue)
                            {
                                <span>
                                    @match.ScheduledAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </span>
                            }
                            else
                            {
                                <span>
                                    Time to be confirmed
                                </span>
                            }


                            @if (match.Status == MatchStatus.Completed && match.WinnerId.HasValue)
                            {
                                <strong>
                                    Winner: @GetWinnerName(match)
                                </strong>
                            }

                        </div>

                            </article>
                            }

                            </div>

                            </section>
                        }

                    </div>
                }

            </section>
        }
        else if (selectedTab == CompetitionTab.Standings)
        {
            <section class="competition-panel">

                <div class="competition-panel-heading">

                    <div>
                        <span class="competition-eyebrow">
                            League table
                        </span>

                        <h2>Tournament standings</h2>
                    </div>

                    @if (standings is not null)
                    {
                        <span class="competition-count">
                            @standings.Standings.Count players
                        </span>
                    }

                </div>

                @if (tournament.Format != TournamentFormat.League)
                {
                    <div class="competition-feature-empty">

                        <div class="competition-feature-icon">
                            🏆
                        </div>

                        <h2>No league standings</h2>

                        <p>
                            Standings are available for league tournaments.
                            This tournament uses
                            @FormatTournamentFormat(tournament.Format).
                        </p>

                    </div>
                }
                else if (isStandingsLoading)
                {
                    <div class="portal-empty-state">
                        Loading standings...
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(standingsError))
                {
                    <div class="portal-empty-state">

                        <h3>Standings unavailable</h3>

                        <p>@standingsError</p>

                        <button type="button"
                                class="portal-button subtle"
                                @onclick="LoadStandingsAsync"> @* ////////////////////////////////////////////////////////////////////////////////// *@
                            Try again
                        </button>

                    </div>
                }
                else if (standings is null || !standings.Standings.Any())
                {
                    <div class="competition-feature-empty">

                        <div class="competition-feature-icon">
                            🏆
                        </div>

                        <h2>Standings aren't available yet</h2>

                        <p>
                            The league table will appear once
                            tournament fixtures have been generated. @* ////////////////////////////////////////////////////////////////////////////////// *@
                        </p>

                    </div>
                }
                else
                {
                    <div class="portal-table-wrap">

                        <table class="portal-table competition-standings-table">

                            <thead>
                                <tr>
                                    <th>Pos</th>
                                    <th>Player</th>
                                    <th>P</th>
                                    <th>W</th>
                                    <th>D</th>
                                    <th>L</th>
                                    <th>SF</th>
                                    <th>SA</th>
                                    <th>SD</th>
                                    <th>Pts</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var standing in standings.Standings)
                                {
                                    <tr @key="standing.PlayerId">

                                        <td>
                                            <strong>
                                                @standing.Position
                                            </strong>
                                        </td>

                                        <td>
                                            <div class="competition-standing-player">

                                                <span class="competition-avatar small">
                                                    @GetInitials(standing.GamerTag)
                                                </span>

                                                <strong>
                                                    @standing.GamerTag
                                                </strong>

                                            </div>
                                        </td>

                                        <td>@standing.Played</td>
                                        <td>@standing.Wins</td>
                                        <td>@standing.Draws</td>
                                        <td>@standing.Losses</td>
                                        <td>@standing.ScoreFor</td>
                                        <td>@standing.ScoreAgainst</td>

                                        <td>
                                            @FormatScoreDifference(
                                            standing.ScoreDifference)
                            </td>

                            <td class="competition-standing-points">
                                <strong>
                                    @standing.Points
                                </strong>
                            </td>

                        </tr>
                                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        
        }

    </div>

</section>
}



<ConfirmDialog IsOpen="@showWithdrawConfirmation"
               Title="Withdraw from tournament?"
               Message="Are you sure you want to withdraw? You will lose your place in this tournament, and you may not be able to register again."
               ConfirmText="Yes, withdraw"
               CancelText="Keep my place"
               ProcessingText="Withdrawing..."
               IsProcessing="@isWithdrawing"
               OnConfirm="WithdrawFromTournamentAsync"
               OnCancel="CloseWithdrawConfirmation" />



@code {

    [Parameter]
    public Guid TournamentId { get; set; }

    private MyTournamentDetailsDto? tournament;

    private string? currentUserId;

    private string errorMessage = "The tournament could not be loaded.";

    private bool isLoading = true;

    private bool isCheckingIn; //player checking in

    private TournamentRegistrationAvailabilityDto? registrationAvailability;

    private bool isRegistrationActionProcessing;

    private CompetitionTab selectedTab = CompetitionTab.Overview;

    private LeagueTournamentStandingsDto? standings;

    private bool isStandingsLoading;

    private bool standingsLoaded;

    private string? standingsError;

    // withdraw from tournament
    private bool showWithdrawConfirmation;

    private bool isWithdrawing;

    //Fixtures Tab
    private TournamentFixtureDto? fixtures;

    private bool isFixturesLoading;

    private bool fixturesLoaded;

    private string? fixturesError;


    // =====================================================
    // LIFECYCLE
    // =====================================================

    protected override async Task OnParametersSetAsync()
    {
        await LoadCurrentUserAsync();

        await LoadTournamentAsync();
    }


    // =====================================================
    // AUTHENTICATION
    // =====================================================

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }


    // =====================================================
    // LOAD TOURNAMENT
    // =====================================================

    private async Task LoadTournamentAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            errorMessage = "Your account could not be identified.";

            isLoading = false;

            return;
        }

        isLoading = true;

        try
        {
            var result = await RegistrationService.GetPlayerTournamentDetailsAsync(TournamentId, currentUserId);

            if (!result.Succeeded || result.Value is null)
            {
                tournament = null;

                errorMessage = result.Error ?? "Tournament could not be loaded.";

                return;
            }

            tournament = result.Value;

            await LoadRegistrationAvailabilityAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            tournament = null;

            errorMessage = "Something went wrong while loading the tournament.";
        }
        finally
        {
            isLoading = false;
        }
    }


    // =====================================================
    // OVERVIEW
    // =====================================================




    // =====================================================
    // CHECK-IN
    // =====================================================

    private bool CanCheckIn()
    {
        return registrationAvailability?.CanCheckIn == true;
    }


    private async Task CheckInAsync()
    {
        if (tournament is null || isCheckingIn || string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        isCheckingIn = true;

        try
        {
            var result = await PlayerRegistrationService.PlayerCheckInAsync(tournament.RegistrationId, currentUserId);

            if (!result.Succeeded)
            {
                Toast.Warning(result.Error ?? "Unable to check in.");

                return;
            }

            Toast.Success(result.Message ?? "You have successfully checked in.");

            await LoadTournamentAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Toast.Error(
                "Something went wrong while checking in.");
        }
        finally
        {
            isCheckingIn = false;
        }
    }


    //Load user's standing onclick
    private async Task LoadStandingsAsync() ////////////////////////////////////////////////////////////////////////////////////////////////////////
    {
        if (TournamentId == Guid.Empty)
            return;

        isStandingsLoading = true;
        standingsError = null;

        try
        {
            var result = await LeagueStandingsService.GetAsync(TournamentId);

            if (!result.Succeeded || result.Value is null)
            {
                standings = null;

                standingsError =
                    result.Error ??
                    "Tournament standings could not be loaded.";

                return;
            }

            standings = result.Value;
            standingsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            standings = null;

            standingsError =
                "Something went wrong while loading the standings.";
        }
        finally
        {
            isStandingsLoading = false;
        }
    }


    private async Task LoadRegistrationAvailabilityAsync()
    {
        registrationAvailability = null;

        if (tournament is null || tournament.RegistrationId == Guid.Empty ||
            string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        var result = await PlayerRegistrationService
                .GetAvailabilityByRegistrationAsync(tournament.RegistrationId, currentUserId);

        if (!result.Succeeded || result.Value is null)
        {
            Console.WriteLine(result.Error ?? "Registration availability could not be loaded.");

            return;
        }

        registrationAvailability = result.Value;
    }


    //Load Fixtures Tab onclik
    private async Task LoadFixturesAsync()
    {
        if (TournamentId == Guid.Empty)
            return;

        isFixturesLoading = true;
        fixturesError = null;

        try
        {
            var result =
                await FixtureService.GetAsync(TournamentId);

            if (!result.Succeeded || result.Value is null)
            {
                fixtures = null;

                fixturesError =
                    result.Error ??
                    "Tournament fixtures could not be loaded.";

                return;
            }

            fixtures = result.Value;
            fixturesLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            fixtures = null;

            fixturesError =
                "Something went wrong while loading the fixtures.";
        }
        finally
        {
            isFixturesLoading = false;
        }
    }


    //Withdraw method
    private async Task WithdrawFromTournamentAsync()
    {
        if (tournament is null ||
            isWithdrawing ||
            string.IsNullOrWhiteSpace(currentUserId))
        {
            return;
        }

        if (registrationAvailability?.CanWithdraw != true)
        {
            Toast.Warning(
                "Withdrawal is not currently available.");

            return;
        }

        isWithdrawing = true;

        try
        {
            var result = await PlayerRegistrationService
                .PlayerWithdrawAsync(
                    tournament.RegistrationId,
                    currentUserId);

            if (!result.Succeeded)
            {
                Toast.Warning(
                    result.Error ??
                    "Unable to withdraw from this tournament.");

                showWithdrawConfirmation = false;

                await LoadTournamentAsync();

                return;
            }

            showWithdrawConfirmation = false;

            Toast.Success(
                result.Message ??
                "You have withdrawn from the tournament.");

            Navigation.NavigateTo("/dashboard/my-tournaments");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Toast.Error(
                "Something went wrong while withdrawing.");
        }
        finally
        {
            isWithdrawing = false;
        }
    }


    private void CloseWithdrawConfirmation()
    {
        if (isWithdrawing)
            return;

        showWithdrawConfirmation = false;
    }





