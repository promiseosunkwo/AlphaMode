    private async Task SelectTab(CompetitionTab tab)
    {
        selectedTab = tab;

        switch (tab)
        {
            case CompetitionTab.Fixtures:

                if (!fixturesLoaded &&
                    !isFixturesLoading)
                {
                    await LoadFixturesAsync();
                }

                break;

            case CompetitionTab.Standings:

                if (tournament is not null &&
                    tournament.Format == TournamentFormat.League &&
                    !standingsLoaded &&
                    !isStandingsLoading)
                {
                    await LoadStandingsAsync();
                }

                break;
        }
    }


    private string GetTabClass(CompetitionTab tab)
    {
        return selectedTab == tab ? "competition-tab active" : "competition-tab";
    }


