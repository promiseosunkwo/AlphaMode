    private bool HasConfirmedRegistration()
    {
        if (tournament is null) return false;

        return tournament.RegistrationStatus == TournamentRegistrationStatus.Registered || tournament.RegistrationStatus == TournamentRegistrationStatus.CheckedIn;
    }


    private string GetRegistrationStatusText()
    {
        if (tournament is null)
            return string.Empty;

        return tournament.RegistrationStatus switch
        {
            TournamentRegistrationStatus.PendingPayment =>
                "Payment pending",

            TournamentRegistrationStatus.Registered =>
                "Registered",

            TournamentRegistrationStatus.CheckedIn =>
                "Checked in",

            TournamentRegistrationStatus.Withdrawn =>
                "Withdrawn",

            TournamentRegistrationStatus.Disqualified =>
                "Disqualified",

            TournamentRegistrationStatus.Cancelled =>
                "Cancelled",

            _ =>
                tournament.RegistrationStatus.ToString()
        };
    }


    private string GetRegistrationStatusClass()
    {
        if (tournament is null)
            return "portal-status";

        return tournament.RegistrationStatus switch
        {
            TournamentRegistrationStatus.Registered =>
                "portal-status open",

            TournamentRegistrationStatus.CheckedIn =>
                "portal-status open",

            TournamentRegistrationStatus.PendingPayment =>
                "portal-status pending",

            TournamentRegistrationStatus.Disqualified =>
                "portal-status danger",

            TournamentRegistrationStatus.Cancelled =>
                "portal-status danger",

            _ =>
                "portal-status"
        };
    }


    private string GetJourneyStepClass(int step)
    {
        if (tournament is null) return "journey-step";

        var complete = step switch
        {
            2 => HasConfirmedRegistration(),

            3 => tournament.RegistrationStatus == TournamentRegistrationStatus.CheckedIn,

            _ => false
        };

        return complete
            ? "journey-step complete"
            : "journey-step";
    }


    private string GetJourneyLineClass(int step)
    {
        if (tournament is null) return "journey-line";

        var complete = step switch
        {
            2 =>
                HasConfirmedRegistration(),

            3 =>
                tournament.RegistrationStatus ==
                TournamentRegistrationStatus.CheckedIn,

            _ =>
                false
        };

        return complete
            ? "journey-line complete"
            : "journey-line";
    }


    private string GetCheckInShortText()
    {
        if (tournament is null) return string.Empty;

        if (tournament.RegistrationStatus == TournamentRegistrationStatus.CheckedIn)
        {
            return "Completed";
        }

        if (tournament.RegistrationStatus == TournamentRegistrationStatus.PendingPayment)
        {
            return "Payment required first";
        }

        return "30 min before start";
    }


    private string GetCheckInMessage()
    {
        if (tournament is null)
            return string.Empty;

        var opens = tournament.StartDate.AddMinutes(-30);

        if (DateTime.UtcNow < opens)
        {
            return $"Check-in opens {opens.ToLocalTime():dd MMM 'at' HH:mm}.";
        }

        if (DateTime.UtcNow >= tournament.StartDate)
        {
            return "The tournament has already started.";
        }

        return "Check-in is now available.";
    }


    private string GetHeroStyle()
    {
        if (tournament is null || string.IsNullOrWhiteSpace(tournament.ImageUrl))
        {
            return string.Empty;
        }

        return $"background-image: url('{tournament.ImageUrl}');";
    }


    private static string FormatTournamentFormat(TournamentFormat format)
    {
        return format.ToString();
    }


    private static string FormatMoney(
        decimal amount,
        string currency)
    {
        return currency.ToUpperInvariant() switch
        {
            "NGN" => $"₦{amount:N0}",

            "GBP" => $"£{amount:N2}",

            "USD" => $"${amount:N2}",

            "EUR" => $"€{amount:N2}",

            _ => $"{currency} {amount:N2}"
        };
    }

    private static string FormatScoreDifference(int scoreDifference)
    {
        return scoreDifference > 0
            ? $"+{scoreDifference}"
            : scoreDifference.ToString();
    }


    private static string GetInitials(string gamerTag)
    {
        if (string.IsNullOrWhiteSpace(gamerTag))
            return "?";

        var value = gamerTag.Trim();

        return value.Length == 1 ? value.ToUpperInvariant() : value[..2].ToUpperInvariant();
    }


