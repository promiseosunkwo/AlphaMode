@page "/admin/games"
@rendermode InteractiveServer
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.ViewModels
@layout AdminLayout
<PageTitle>Games · AlphaMode Admin</PageTitle>
<AdminPageHeader Title="Game catalogue" Description="Control the titles and platforms available when competitions are configured."><Actions><button class="adm-button primary" @onclick="Create">＋ Add game</button></Actions></AdminPageHeader>
<section class="adm-panel"><div class="adm-toolbar"><label class="adm-search"><span>⌕</span><input @bind="query" @bind:event="oninput" placeholder="Search catalogue…" /></label><span class="adm-result-count">@Filtered.Count() titles</span></div><div class="adm-card-grid">@foreach(var game in Filtered){<article class="adm-game-card"><div class="adm-game-art">@game.Name[0]</div><div><span class="adm-status @(game.Enabled?"active":"suspended")">@(game.Enabled?"Enabled":"Disabled")</span><h3>@game.Name</h3><p>@game.Genre · @game.Platform</p></div><div class="adm-card-actions"><button @onclick="()=>Edit(game)">Edit</button><button @onclick="()=>game.Enabled=!game.Enabled">@(game.Enabled?"Disable":"Enable")</button><button class="danger" @onclick="()=>items.Remove(game)">Delete</button></div></article>}</div></section>
<AdminModal IsOpen="open" Title="@(model.Id==0?"Add game":"Edit game")" OnClose="Close"><ChildContent><div class="adm-form-grid"><label class="span-2">Game name<input @bind="model.Name" /></label><label>Genre<input @bind="model.Genre" /></label><label>Platform<select @bind="model.Platform"><option>PC</option><option>PlayStation</option><option>Xbox</option><option>Mobile</option><option>Cross-platform</option></select></label><label class="adm-checkbox span-2"><input type="checkbox" @bind="model.Enabled" /> Available for new tournaments</label></div></ChildContent><Footer><button class="adm-button secondary" @onclick="Close">Cancel</button><button class="adm-button primary" @onclick="Save">Save game</button></Footer></AdminModal>
@code {private string query="";private bool open;private AdminGameItem model=new();private readonly List<AdminGameItem> items=[new(){Id=1,Name="Valorant",Genre="Tactical shooter",Platform="PC"},new(){Id=2,Name="EA Sports FC 26",Genre="Sports",Platform="Cross-platform"},new(){Id=3,Name="Call of Duty Mobile",Genre="Shooter",Platform="Mobile"},new(){Id=4,Name="Rocket League",Genre="Sports",Platform="Cross-platform",Enabled=false}];private IEnumerable<AdminGameItem> Filtered=>items.Where(x=>string.IsNullOrWhiteSpace(query)||x.Name.Contains(query,StringComparison.OrdinalIgnoreCase));private void Create(){model=new(){Platform="PC"};open=true;}private void Edit(AdminGameItem x){model=new(){Id=x.Id,Name=x.Name,Genre=x.Genre,Platform=x.Platform,Enabled=x.Enabled};open=true;}private void Save(){if(string.IsNullOrWhiteSpace(model.Name))return;var x=items.FirstOrDefault(i=>i.Id==model.Id);if(x is null){model.Id=items.Max(i=>i.Id)+1;items.Add(model);}else{x.Name=model.Name;x.Genre=model.Genre;x.Platform=model.Platform;x.Enabled=model.Enabled;}Close();}private void Close()=>open=false;}
