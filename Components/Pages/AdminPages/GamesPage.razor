@page "/admin/games"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using AlphaMode.Application.Games.DTOs
@using AlphaMode.Application.Games.Interfaces
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.Components.Shared.ConfirmDialog
@using AlphaMode.Components.Shared.Toast
@using AlphaMode.Services

@inject IGameService GameService
@inject ToastService Toast

@layout AdminLayout

<PageTitle>Games · AlphaMode Admin</PageTitle>

<ToastContainer />


<AdminPageHeader Title="Game catalogue"
                 Description="Control the titles and platforms available when competitions are configured.">

    <Actions>
        <button type="button"
                class="adm-button primary"
                @onclick="OpenCreateModal">
            ＋ Add game
        </button>
    </Actions>

</AdminPageHeader>


<section class="adm-panel">

    <div class="adm-toolbar">

        <label class="adm-search">

            <span>⌕</span>

            <input placeholder="Search catalogue…"
                   @bind="query"
                   @bind:event="oninput" />

        </label>

        <span class="adm-result-count">
            @FilteredGames.Count() titles
        </span>

    </div>


    @if (isLoading)
    {
        <div class="adm-empty-state">
            Loading games...
        </div>
    }
    else if (!FilteredGames.Any())
    {
        <div class="adm-empty-state">

            @if (string.IsNullOrWhiteSpace(query))
            {
                <p>No games have been added yet.</p>
            }
            else
            {
                <p>No games match your search.</p>
            }

        </div>
    }
    else
    {
        <div class="adm-card-grid">

            @foreach (var game in FilteredGames)
            {
                <article class="adm-game-card"
                         @key="game.Id">

                    <div class="adm-game-art">

                        @if (!string.IsNullOrWhiteSpace(game.ImageUrl))
                        {
                            <img src="@game.ImageUrl"
                                 alt="@game.Name"
                                 loading="lazy" />
                        }
                        else
                        {
                            <span>
                                @GetGameInitial(game.Name)
                            </span>
                        }

                </div>


                <div>

                    <span class="adm-status @(game.IsActive ? "active" : "suspended")">
                        @(game.IsActive ? "Enabled" : "Disabled")
                    </span>

                    <h3>
                        @game.Name
                    </h3>

                    <p>
                        @game.Version · @game.Platform
                    </p>

                    <small>
                        @game.TournamentCount
                        @(game.TournamentCount == 1
                                            ? "tournament"
                                            : "tournaments")
                </small>

                    </div>


                    <div class="adm-card-actions">

                        <button type="button"
                                disabled="@IsProcessing(game.Id)"
                                @onclick="() => OpenEditModal(game)">
                            Edit
                        </button>


                @if (game.IsActive)
                        {
                            <button type="button"
                                    disabled="@IsProcessing(game.Id)"
                                    @onclick="() => DeactivateGameAsync(game.Id)">
                                Disable
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    disabled="@IsProcessing(game.Id)"
                                    @onclick="() => ActivateGameAsync(game.Id)">
                                Enable
                            </button>
                        }


                        <button type="button"
                                class="danger"
                                disabled="@IsProcessing(game.Id)"
                                @onclick="() => RequestDelete(game)">
                            Delete
                        </button>

                    </div>

                </article>
            }

        </div>
    }

</section>


@* =========================================================
   CREATE / EDIT MODAL
   ========================================================= *@

<AdminModal IsOpen="@showModal"
            Eyebrow="Game management"
            Title="@ModalTitle"
            EditContext="@editContext"
            OnValidSubmit="SaveGameAsync"
            OnClose="CloseModal">

    <ChildContent>

        <div class="adm-form-grid">

            <label class="span-2">

                Game name

                <InputText @bind-Value="model.Name"
                           placeholder="e.g. EA Sports FC 26" />

                <ValidationMessage For="@(() => model.Name)" />

            </label>


            <label>

                Version

                <InputText @bind-Value="model.Version"
                           placeholder="e.g. FC 26" />

                <ValidationMessage For="@(() => model.Version)" />

            </label>


            <label>

                Platform

                <InputSelect @bind-Value="model.Platform">

                    <option value="">
                        Select platform
                    </option>

                    <option value="PC">
                        PC
                    </option>

                    <option value="PlayStation">
                        PlayStation
                    </option>

                    <option value="Xbox">
                        Xbox
                    </option>

                    <option value="Mobile">
                        Mobile
                    </option>

                    <option value="Cross-platform">
                        Cross-platform
                    </option>

                </InputSelect>

                <ValidationMessage For="@(() => model.Platform)" />

            </label>


            <label class="span-2">

                Image URL

                <InputText @bind-Value="model.ImageUrl"
                           placeholder="https://..." />

                <ValidationMessage For="@(() => model.ImageUrl)" />

            </label>


            @if (isEditing)
            {
                <label class="adm-checkbox span-2">

                    <InputCheckbox @bind-Value="editIsActive" />

                    Game is active

                </label>
            }

        </div>

    </ChildContent>


    <Footer>

        <button type="button"
                class="adm-button secondary"
                disabled="@isSaving"
                @onclick="CloseModal">
            Cancel
        </button>


        <button type="submit"
                class="adm-button primary"
                disabled="@isSaving">

            @if (isSaving)
            {
                <span>
                    Saving...
                </span>
            }
            else
            {
                <span>
                    @(isEditing
                    ? "Save changes"
                    : "Add game")
            </span>
                        }

        </button>

    </Footer>

</AdminModal>


@* =========================================================
   DELETE CONFIRMATION
   ========================================================= *@

<ConfirmDialog IsOpen="@showDeleteConfirmation"
               Title="Delete game?"
               Message="@deleteConfirmationMessage"
               ConfirmText="Delete game"
               ProcessingText="Deleting..."
               IsProcessing="@isDeleting"
               OnConfirm="ConfirmDeleteGameAsync"
               OnCancel="CancelDelete" />


@code {

    // =======================================================
    // DATA
    // =======================================================

    private IReadOnlyList<GameDto> games = [];


    // =======================================================
    // FORM
    // =======================================================

    private CreateGameRequest model = new();

    private EditContext? editContext;

    private Guid? editingGameId;

    private bool editIsActive = true;

    private bool isEditing;

    private bool isSaving;

    private string ModalTitle =>
        isEditing
            ? "Edit game"
            : "Add game";


    // =======================================================
    // PAGE STATE
    // =======================================================

    private bool isLoading;

    private bool showModal;

    private string query = string.Empty;

    private Guid? processingGameId;


    // =======================================================
    // DELETE STATE
    // =======================================================

    private GameDto? gameToDelete;

    private bool showDeleteConfirmation;

    private bool isDeleting;


    private string deleteConfirmationMessage =>
        gameToDelete is null
            ? "This action cannot be undone."
            : $"You're about to permanently delete {gameToDelete.Name}. This action cannot be undone.";


    // =======================================================
    // FILTERING
    // =======================================================

    private IEnumerable<GameDto> FilteredGames =>
        games.Where(game =>
            string.IsNullOrWhiteSpace(query)
            ||
            game.Name.Contains(
                query,
                StringComparison.OrdinalIgnoreCase)
            ||
            game.Platform.Contains(
                query,
                StringComparison.OrdinalIgnoreCase)
            ||
            game.Version.Contains(
                query,
                StringComparison.OrdinalIgnoreCase));


    // =======================================================
    // INITIALIZATION
    // =======================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadGamesAsync();
    }


    // =======================================================
    // LOAD
    // =======================================================

    private async Task LoadGamesAsync()
    {
        isLoading = true;

        try
        {
            var result =
                await GameService.GetAllAsync();


            if (!result.Succeeded)
            {
                games = [];

                Toast.Error(
                    result.Error
                    ?? "Unable to load games.");

                return;
            }


            games =
                result.Value ?? [];
        }
        catch (Exception ex)
        {
            games = [];

            Console.WriteLine(
                $"Error loading games: {ex}");

            Toast.Error(
                "Something went wrong while loading games.");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =======================================================
    // OPEN CREATE
    // =======================================================

    private void OpenCreateModal()
    {
        model = new CreateGameRequest
        {
            Name = string.Empty,
            Version = string.Empty,
            Platform = string.Empty,
            ImageUrl = null
        };


        editContext =
            new EditContext(model);


        editingGameId = null;

        editIsActive = true;

        isEditing = false;

        showModal = true;
    }


    // =======================================================
    // OPEN EDIT
    // =======================================================

    private void OpenEditModal(GameDto game)
    {
        model = new CreateGameRequest
        {
            Name = game.Name,
            Version = game.Version,
            Platform = game.Platform,
            ImageUrl = game.ImageUrl
        };


        editContext =
            new EditContext(model);


        editingGameId =
            game.Id;

        editIsActive =
            game.IsActive;

        isEditing =
            true;

        showModal =
            true;
    }


    // =======================================================
    // SAVE
    // =======================================================

    private async Task SaveGameAsync()
    {
        if (isSaving)
            return;


        isSaving = true;


        try
        {
            if (isEditing)
            {
                await UpdateGameAsync();
            }
            else
            {
                await CreateGameAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }


    // =======================================================
    // CREATE
    // =======================================================

    private async Task CreateGameAsync()
    {
        try
        {
            var request =
                new CreateGameRequest
                {
                    Name = model.Name,
                    Version = model.Version,
                    Platform = model.Platform,
                    ImageUrl = model.ImageUrl
                };


            var result =
                await GameService.CreateAsync(request);


            if (!result.Succeeded)
            {
                Toast.Warning(
                    result.Error
                    ?? "Unable to create game.");

                return;
            }


            Toast.Success(
                result.Message
                ?? "Game created successfully.");


            CloseModal();


            await LoadGamesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error creating game: {ex}");

            Toast.Error(
                "Something went wrong while creating the game.");
        }
    }


    // =======================================================
    // UPDATE
    // =======================================================

    private async Task UpdateGameAsync()
    {
        if (!editingGameId.HasValue)
        {
            Toast.Warning(
                "Unable to determine which game is being edited.");

            return;
        }


        try
        {
            var request =
                new UpdateGameRequest
                {
                    Id = editingGameId.Value,

                    Name = model.Name,

                    Version = model.Version,

                    Platform = model.Platform,

                    ImageUrl = model.ImageUrl,

                    IsActive = editIsActive
                };


            var result =
                await GameService.UpdateAsync(request);


            if (!result.Succeeded)
            {
                Toast.Warning(
                    result.Error
                    ?? "Unable to update game.");

                return;
            }


            Toast.Success(
                result.Message
                ?? "Game updated successfully.");


            CloseModal();


            await LoadGamesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating game: {ex}");

            Toast.Error("Something went wrong while updating the game.");
        }
    }


    // =======================================================
    // ACTIVATE
    // =======================================================

    private async Task ActivateGameAsync(Guid id)
    {
        if (processingGameId.HasValue)
            return;


        processingGameId = id;

        try
        {
            var result = await GameService.ActivateAsync(id);


            if (!result.Succeeded)
            {
                Toast.Warning(result.Error ?? "Unable to activate game.");

                return;
            }

            Toast.Success(result.Message ?? "Game activated successfully.");

            await LoadGamesAsync();
        }
        catch (Exception)
        {
            // Console.WriteLine($"Error activating game: {ex}");

            Toast.Error(
                "Something went wrong while activating the game.");
        }
        finally
        {
            processingGameId = null;
        }
    }


    // =======================================================
    // DEACTIVATE
    // =======================================================

    private async Task DeactivateGameAsync(Guid id)
    {
        if (processingGameId.HasValue)
            return;

        processingGameId = id;


        try
        {
            var result = await GameService.DeactivateAsync(id);


            if (!result.Succeeded)
            {
                Toast.Warning(result.Error ?? "Unable to deactivate game.");

                return;
            }

            Toast.Success(result.Message ?? "Game deactivated successfully.");

            await LoadGamesAsync();
        }
        catch (Exception)
        {
            // Console.WriteLine($"Error deactivating game: {ex}");

            Toast.Error("Something went wrong while deactivating the game.");
        }
        finally
        {
            processingGameId = null;
        }
    }


    // =======================================================
    // REQUEST DELETE
    // =======================================================

    private void RequestDelete(GameDto game)
    {
        if (processingGameId.HasValue ||
            isDeleting)
        {
            return;
        }

        gameToDelete = game;

        showDeleteConfirmation = true;
    }

    // =======================================================
    // CONFIRM DELETE
    // =======================================================

    private async Task ConfirmDeleteGameAsync()
    {
        if (gameToDelete is null ||
            isDeleting)
        {
            return;
        }


        isDeleting =true;

        try
        {
            var result = await GameService.DeleteAsync(gameToDelete.Id);


            if (!result.Succeeded)
            {
                Toast.Warning(result.Error ?? "Unable to delete game.");

                return;
            }


            showDeleteConfirmation = false;


            Toast.Success(result.Message ?? "Game deleted successfully.");


            gameToDelete = null;

            await LoadGamesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting game: {ex}");

            Toast.Error("Something went wrong while deleting the game.");
        }
        finally
        {
            isDeleting = false;
        }
    }


    // =======================================================
    // CANCEL DELETE
    // =======================================================

    private void CancelDelete()
    {
        if (isDeleting)
            return;

        showDeleteConfirmation = false;

        gameToDelete = null;
    }


    // =======================================================
    // CLOSE MODAL
    // =======================================================

    private void CloseModal()
    {
        showModal = false;

        editingGameId = null;

        editIsActive = true;

        isEditing = false;


        editContext = null;


        model = new CreateGameRequest();
    }


    // =======================================================
    // HELPERS
    // =======================================================

    private bool IsProcessing(Guid id)
    {
        return processingGameId == id;
    }


    private static string GetGameInitial(
        string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";


        return name
            .Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }

}