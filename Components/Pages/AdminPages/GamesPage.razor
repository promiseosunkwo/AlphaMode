@page "/admin/games"
@rendermode InteractiveServer
@using AlphaMode.Application.Games.DTOs
@using AlphaMode.Application.Games.Interfaces
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.Services
@using AlphaMode.ViewModels
@inject IGameService GameService
@inject ToastService Toast
@layout AdminLayout

<PageTitle>Games · AlphaMode Admin</PageTitle>
<AdminPageHeader Title="Game catalogue" Description="Control the titles and platforms available when competitions are configured.">
    <Actions>
        <button class="adm-button primary" @onclick="Create">＋ Add game</button>
    </Actions>
    </AdminPageHeader>
<section class="adm-panel">
    <div class="adm-toolbar">
        <label class="adm-search"><span>⌕</span>
            <input @bind="query" @bind:event="oninput" placeholder="Search catalogue…" />
        </label><span class="adm-result-count">@Filtered.Count() titles</span>
    </div>
    <div class="adm-card-grid">
        @foreach(var game in Filtered){
            <article class="adm-game-card">
                <div class="adm-game-art">@game.Name[0]</div>
                <div>
                    <span class="adm-status @(game.IsActive ? "active" : "suspended")">@(game.IsActive ? "Enabled" : "Disabled")</span>
                    <h3>@game.Name</h3>
                    <p>@game.Version · @game.Platform</p>
                </div>
                <div class="adm-card-actions">
                    <button @onclick="()=>Edit(game)">Edit</button>
                    <button @onclick="() => game.IsActive = !game.IsActive">@(game.IsActive ? "Disable" : "Enable")</button>
                    <button class="danger" @onclick="()=>items.Remove(game)">Delete</button>
                </div>
                </article>
          }
     </div>
</section>

<AdminModal IsOpen="open" Title="@(model.Id==0?"Add game":"Edit game")" OnClose="Close">
    <ChildContent>
        <EditForm Model="Model" OnValidSubmit="CreateGameAsync">
    <div class="adm-form-grid">
        <label class="span-2">Game name<input @bind="Model.Name" /></label>
        <label>Genre<input @bind="Model.Version" /></label>
        <label>Platform<select @bind="Model.Platform">
            <option>PC</option>
            <option>PlayStation</option>
            <option>Xbox</option>
            <option>Mobile</option>
            <option>Cross-platform</option>
        </select>
        </label>
        <label class="adm-checkbox span-2">
            <input type="checkbox" @bind="model.IsActive" /> Is Tournament active?
        </label>
        </div>
        </EditForm>
    </ChildContent>
    
    <Footer>

        <button class="adm-button secondary" @onclick="Close">Cancel</button>
        <button class="adm-button primary" @onclick="Save">Save game</button>

    </Footer>

    </AdminModal>


@code {

    private IReadOnlyList<GameDto> Games = [];

    private CreateGameRequest Model = new();

    private bool isLoading;

    private bool isSubmitting;

    private string query="";

    private bool open;

    private AdminGameItem model= new();

    protected override async Task OnInitializedAsync()
    {
        await LoadGamesAsync();

        var result = await GameService.GetAllAsync();

        if (!result.Succeeded)
        {
            Toast.Error(
                result.Error ?? "Unable to load games.");

            return;
        }

        Games = result.Value ?? [];
    }

    private async Task CreateGameAsync()
    {
        var result = await GameService.CreateAsync(
            new CreateGameRequest
            {
                Name = Model.Name,
                Version = Model.Version,
                Platform = Model.Platform,
                ImageUrl = Model.ImageUrl
            });

        if (!result.Succeeded)
        {
            Toast.Warning(result.Error!);
            return;
        }

        Toast.Success(result.Message!);

        await LoadGamesAsync();
    }

    private async Task DeactivateGameAsync(Guid id)
    {
        var result =
            await GameService.DeactivateAsync(id);

        if (!result.Succeeded)
        {
            Toast.Warning(result.Error!);
            return;
        }

        Toast.Success(result.Message!);

        await LoadGamesAsync();
    }

    private readonly List<AdminGameItem> items = [new() { Id = 1, Name = "Valorant", Version = "Tactical shooter", Platform = "PC" }, new() { Id = 2, Name = "EA Sports FC 26", Version = "Sports", Platform = "Cross-platform" }, new() { Id = 3, Name = "Call of Duty Mobile", Version = "Shooter", Platform = "Mobile" }, new() { Id = 4, Name = "Rocket League", Version = "Sports", Platform = "Cross-platform", IsActive = false }];
    private IEnumerable<AdminGameItem> Filtered=>items.Where(x=>string.IsNullOrWhiteSpace(query)||x.Name.Contains(query,StringComparison.OrdinalIgnoreCase));
    private void Create(){model=new(){Platform="PC"};open=true;}
    private void Edit(AdminGameItem x)
    {
        model = new()
        {
            Id=x.Id,
            Name=x.Name,
            Slug = x.Slug,
            Version = x.Version,
            Platform=x.Platform,
            IsActive = x.IsActive
        }
        ;open=true;
        }

    private async Task DeleteGameAsync(Guid id)
    {
        var result =
            await GameService.DeleteAsync(id);

        if (!result.Succeeded)
        {
            Toast.Warning(result.Error!);
            return;
        }

        Toast.Success(result.Message!);

        await LoadGamesAsync();
    }

    private async Task LoadGamesAsync()
    {
        isLoading = true;

        try
        {
            var result = await GameService.GetAllAsync();

            if (!result.Succeeded)
            {
                Toast.Error(
                    result.Error ?? "Unable to load games.");

                Games = [];
                return;
            }

            Games = result.Value ?? [];
        }
        catch
        {
            Games = [];

            Toast.Error(
                "Something went wrong while loading games.");
        }
        finally
        {
            isLoading = false;
        }
    }


    private void Save(){

        if(string.IsNullOrWhiteSpace(model.Name))

            return;var x=items.FirstOrDefault(i=>i.Id==model.Id);

        if(x is null){model.Id=items.Max(i=>i.Id)+1;items.Add(model);
        }
        else
        {
            x.Name=model.Name;
            x.Slug = model.Slug;
            x.Version=model.Version;
            x.Platform=model.Platform;
            x.IsActive=model.IsActive;
        }Close();
        }


        private void Close()=>open=false;
    }
