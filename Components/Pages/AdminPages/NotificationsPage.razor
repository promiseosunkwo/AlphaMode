@page "/admin/notifications"
@rendermode InteractiveServer
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.ViewModels
@layout AdminLayout
<PageTitle>Notifications · AlphaMode Admin</PageTitle>
<AdminPageHeader Title="Notifications" Description="Create targeted announcements and review the communication history."><Actions><button class="adm-button primary" @onclick="Compose">✦ Compose notification</button></Actions></AdminPageHeader>
<section class="adm-panel"><div class="adm-panel-header"><div><p class="adm-eyebrow">Communication log</p><h2>Recently sent</h2></div><span class="adm-count">@items.Count</span></div><div class="adm-notification-list">@foreach(var note in items){<article><span class="adm-notification-icon">✦</span><div><div class="adm-notification-heading"><strong>@note.Title</strong><span>@note.CreatedAt.ToString("dd MMM · HH:mm")</span></div><p>@note.Message</p><small>@note.Audience · @note.Channel</small></div><button class="adm-icon-button danger" title="Delete" @onclick="()=>items.Remove(note)">✕</button></article>}</div></section>
<AdminModal IsOpen="open" Title="Compose notification" Eyebrow="Broadcast" OnClose="Close"><ChildContent><div class="adm-form-grid"><label>Audience<select @bind="model.Audience"><option>All players</option><option>Tournament participants</option><option>Administrators</option><option>Inactive players</option></select></label><label>Channel<select @bind="model.Channel"><option>In-app</option><option>Email + in-app</option><option>Email</option></select></label><label class="span-2">Title<input @bind="model.Title" /></label><label class="span-2">Message<textarea rows="5" @bind="model.Message"></textarea></label><p class="adm-form-note span-2">This prototype stores the notification only in the current page. Delivery services can be connected later.</p></div></ChildContent><Footer><button class="adm-button secondary" @onclick="Close">Save draft</button><button class="adm-button primary" @onclick="Send">Send notification</button></Footer></AdminModal>
@code {private bool open;private AdminNotificationItem model=new();private readonly List<AdminNotificationItem> items=[new(){Id=1,Title="Valorant check-in is open",Message="Participants can now confirm their place for tonight's fixtures.",Audience="Tournament participants",Channel="Email + in-app",CreatedAt=DateTime.Now.AddHours(-2)},new(){Id=2,Title="Scheduled maintenance",Message="The competition portal will be unavailable for approximately 15 minutes.",CreatedAt=DateTime.Now.AddDays(-1)}];private void Compose(){model=new();open=true;}private void Send(){if(string.IsNullOrWhiteSpace(model.Title))return;model.Id=items.Max(x=>x.Id)+1;model.CreatedAt=DateTime.Now;items.Insert(0,model);Close();}private void Close()=>open=false;}
