@page "/admin/players"
@rendermode InteractiveServer
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.ViewModels
@layout AdminLayout
<PageTitle>Players · AlphaMode Admin</PageTitle>
<AdminPageHeader Title="Players" Description="Manage player profiles, eligibility, account state and competitive standing."><Actions><button class="adm-button primary" @onclick="Create">＋ Add player</button></Actions></AdminPageHeader>
<section class="adm-panel"><div class="adm-toolbar"><label class="adm-search"><span>⌕</span><input @bind="query" @bind:event="oninput" placeholder="Search gamer tag or email…" /></label><select @bind="filter"><option>All</option><option>Active</option><option>Pending</option><option>Suspended</option></select><span class="adm-result-count">@Filtered.Count() players</span></div><div class="adm-table-wrap"><table class="adm-table"><thead><tr><th>Player</th><th>Ranking</th><th>Matches</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in Filtered){<tr><td><div class="adm-person"><span>@Initials(p.GamerTag)</span><div><strong>@p.GamerTag</strong><small>@p.Email</small></div></div></td><td>#@p.Ranking</td><td>@p.Matches</td><td><span class="adm-status @p.Status.ToLower()">@p.Status</span></td><td class="adm-row-actions"><button @onclick="()=>Edit(p)">Edit</button><button class="danger" @onclick="()=>items.Remove(p)">Delete</button></td></tr>}</tbody></table></div></section>
<AdminModal IsOpen="open" Title="@(model.Id==0?"Add player":"Edit player")" OnClose="Close"><ChildContent><div class="adm-form-grid"><label>Gamer tag<input @bind="model.GamerTag" /></label><label>Email<input type="email" @bind="model.Email" /></label><label>Ranking<input type="number" min="1" @bind="model.Ranking" /></label><label>Status<select @bind="model.Status"><option>Active</option><option>Pending</option><option>Suspended</option></select></label></div></ChildContent><Footer><button class="adm-button secondary" @onclick="Close">Cancel</button><button class="adm-button primary" @onclick="Save">Save player</button></Footer></AdminModal>
@code { private string query="",filter="All";private bool open;private AdminPlayerItem model=new();private readonly List<AdminPlayerItem> items=[new(){Id=1,GamerTag="NovaStrike",Email="nova@example.com",Ranking=1,Matches=84,Status="Active"},new(){Id=2,GamerTag="KingPromise",Email="promise@example.com",Ranking=4,Matches=71,Status="Active"},new(){Id=3,GamerTag="NightOwl",Email="night@example.com",Ranking=27,Matches=19,Status="Pending"}];private IEnumerable<AdminPlayerItem> Filtered=>items.Where(x=>(filter=="All"||x.Status==filter)&&(string.IsNullOrWhiteSpace(query)||x.GamerTag.Contains(query,StringComparison.OrdinalIgnoreCase)||x.Email.Contains(query,StringComparison.OrdinalIgnoreCase)));private static string Initials(string s)=>string.Join("",s.Split(' ',StringSplitOptions.RemoveEmptyEntries).Select(x=>x[0])).ToUpperInvariant()[..Math.Min(2,string.Join("",s.Split(' ',StringSplitOptions.RemoveEmptyEntries).Select(x=>x[0])).Length)];private void Create(){model=new();open=true;}private void Edit(AdminPlayerItem x){model=new(){Id=x.Id,GamerTag=x.GamerTag,Email=x.Email,Ranking=x.Ranking,Matches=x.Matches,Status=x.Status};open=true;}private void Save(){if(string.IsNullOrWhiteSpace(model.GamerTag))return;var x=items.FirstOrDefault(i=>i.Id==model.Id);if(x is null){model.Id=items.Max(i=>i.Id)+1;items.Insert(0,model);}else{x.GamerTag=model.GamerTag;x.Email=model.Email;x.Ranking=model.Ranking;x.Status=model.Status;}Close();}private void Close()=>open=false;}
