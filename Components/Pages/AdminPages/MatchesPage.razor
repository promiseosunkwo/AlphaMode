@page "/admin/matches"
@rendermode InteractiveServer
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.ViewModels
@layout AdminLayout
<PageTitle>Matches · AlphaMode Admin</PageTitle>
<AdminPageHeader Title="Matches & fixtures" Description="Schedule fixtures, monitor live play and record match progression."><Actions><button class="adm-button primary" @onclick="Create">＋ Schedule match</button></Actions></AdminPageHeader>
<div class="adm-segmented">@foreach(var s in new[]{"All","Live","Scheduled","Completed"}){<button class="@(filter==s?"active":"")" @onclick="()=>filter=s">@s</button>}</div>
<section class="adm-panel"><div class="adm-table-wrap"><table class="adm-table"><thead><tr><th>Fixture</th><th>Tournament</th><th>Scheduled</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var match in Filtered){<tr><td><strong>@match.PlayerOne <span class="adm-versus">vs</span> @match.PlayerTwo</strong></td><td>@match.Tournament</td><td>@match.ScheduledFor.ToString("dd MMM · HH:mm")</td><td><span class="adm-status @match.Status.ToLower()">@match.Status</span></td><td class="adm-row-actions"><button @onclick="()=>Edit(match)">Edit</button><button class="danger" @onclick="()=>items.Remove(match)">Delete</button></td></tr>}</tbody></table></div></section>
<AdminModal IsOpen="open" Title="@(model.Id==0?"Schedule match":"Edit fixture")" OnClose="Close"><ChildContent><div class="adm-form-grid"><label class="span-2">Tournament<input @bind="model.Tournament" /></label><label>Player / team one<input @bind="model.PlayerOne" /></label><label>Player / team two<input @bind="model.PlayerTwo" /></label><label>Scheduled time<input type="datetime-local" @bind="model.ScheduledFor" /></label><label>Status<select @bind="model.Status"><option>Scheduled</option><option>Live</option><option>Completed</option></select></label></div></ChildContent><Footer><button class="adm-button secondary" @onclick="Close">Cancel</button><button class="adm-button primary" @onclick="Save">Save fixture</button></Footer></AdminModal>
@code {private string filter="All";private bool open;private AdminMatchItem model=new();private readonly List<AdminMatchItem> items=[new(){Id=1,Tournament="Valorant Masters",PlayerOne="NovaStrike",PlayerTwo="PixelRaiders",ScheduledFor=DateTime.Now.AddMinutes(-20),Status="Live"},new(){Id=2,Tournament="FIFA Elite Cup",PlayerOne="KingPromise",PlayerTwo="GoalMachine",ScheduledFor=DateTime.Now.AddHours(3),Status="Scheduled"},new(){Id=3,Tournament="CODM Weekend League",PlayerOne="ApexCore",PlayerTwo="NightOwl",ScheduledFor=DateTime.Now.AddDays(1),Status="Scheduled"}];private IEnumerable<AdminMatchItem> Filtered=>items.Where(x=>filter=="All"||x.Status==filter);private void Create(){model=new(){ScheduledFor=DateTime.Now.AddDays(1)};open=true;}private void Edit(AdminMatchItem x){model=new(){Id=x.Id,Tournament=x.Tournament,PlayerOne=x.PlayerOne,PlayerTwo=x.PlayerTwo,ScheduledFor=x.ScheduledFor,Status=x.Status};open=true;}private void Save(){if(string.IsNullOrWhiteSpace(model.PlayerOne))return;var x=items.FirstOrDefault(i=>i.Id==model.Id);if(x is null){model.Id=items.Max(i=>i.Id)+1;items.Add(model);}else{x.Tournament=model.Tournament;x.PlayerOne=model.PlayerOne;x.PlayerTwo=model.PlayerTwo;x.ScheduledFor=model.ScheduledFor;x.Status=model.Status;}Close();}private void Close()=>open=false;}
