@page "/admin/payments"
@rendermode InteractiveServer

@using AlphaMode.Application.Common.Models
@using AlphaMode.Application.Payments.DTOs
@using AlphaMode.Application.Payments.Interfaces
@using AlphaMode.Application.Payments.Requests
@using AlphaMode.Domain.Enums

@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.Components.Shared.ConfirmDialog
@using AlphaMode.Components.Shared.Toast
@using AlphaMode.Services

@inject IPaymentService PaymentService
@inject ToastService Toast

@layout AdminLayout

<PageTitle>Payments · AlphaMode Admin</PageTitle>

<ToastContainer />

<AdminPageHeader Title="Payments"
                 Description="Track tournament revenue, payment attempts and transaction activity.">

    <Actions>
        <span class="adm-result-count">
            @pagedResult.TotalCount transactions
        </span>
    </Actions>

</AdminPageHeader>


@* =========================================================
   SUMMARY
   ========================================================= *@

<section class="payment-summary-grid">

    <article class="payment-summary-card revenue">

        <div class="payment-summary-icon">
            ₦
        </div>

        <div>
            <span>Completed revenue</span>

            <strong>
                ₦@summary.CompletedRevenue.ToString("N0")
            </strong>

            <small>
                @summary.CompletedCount completed payments
            </small>
        </div>

    </article>


    <article class="payment-summary-card pending">

        <div class="payment-summary-icon">
            ◷
        </div>

        <div>
            <span>Pending</span>

            <strong>
                ₦@summary.PendingAmount.ToString("N0")
            </strong>

            <small>
                @summary.PendingCount transactions
            </small>
        </div>

    </article>


    <article class="payment-summary-card failed">

        <div class="payment-summary-icon">
            ×
        </div>

        <div>
            <span>Failed</span>

            <strong>
                @summary.FailedCount
            </strong>

            <small>
                failed attempts
            </small>
        </div>

    </article>


    <article class="payment-summary-card refunded">

        <div class="payment-summary-icon">
            ↶
        </div>

        <div>
            <span>Refunded</span>

            <strong>
                @summary.RefundedCount
            </strong>

            <small>
                refunded transactions
            </small>
        </div>

    </article>

</section>


<section class="adm-panel">

    @* =====================================================
       FILTERS
       ===================================================== *@

    <div class="adm-toolbar">

        <label class="adm-search">

            <span>⌕</span>

            <input value="@search"
                   @oninput="HandleSearchInput"
                   placeholder="Search reference, player or tournament…" />

        </label>


        <select value="@SelectedStatusValue"
                @onchange="StatusChangedAsync">

            <option value="">All statuses</option>

            @foreach (var status in Enum.GetValues<PaymentStatus>())
            {
                <option value="@((int)status)">
                    @GetStatusText(status)
                </option>
            }

        </select>


        <select value="@SelectedTypeValue"
                @onchange="TypeChangedAsync">

            <option value="">All types</option>

            @foreach (var type in Enum.GetValues<PaymentType>())
            {
                <option value="@((int)type)">
                    @GetTypeText(type)
                </option>
            }

        </select>


        <select value="@SelectedMethodValue"
                @onchange="MethodChangedAsync">

            <option value="">All methods</option>

            @foreach (var method in Enum.GetValues<PaymentMethod>())
            {
                <option value="@((int)method)">
                    @GetMethodText(method)
                </option>
            }

        </select>


        <span class="adm-result-count">
            @pagedResult.TotalCount results
        </span>

    </div>


    @* =====================================================
       TABLE
       ===================================================== *@

    @if (isLoading)
    {
        <div class="adm-empty-state">
            Loading payments...
        </div>
    }
    else if (pagedResult.Items.Count == 0)
    {
        <div class="adm-empty-state">

            <p>No payment transactions found.</p>

            @if (HasFilters)
            {
                <button type="button"
                        class="adm-button secondary"
                        @onclick="ClearFiltersAsync">

                    Clear filters

                </button>
            }

        </div>
    }
    else
    {
        <div class="adm-table-wrap">

            <table class="adm-table payment-table">

                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Transaction</th>
                        <th>For</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var payment in pagedResult.Items)
                    {
                        <tr @key="payment.Id">

                            <td>

                                <div class="adm-person">

                                    @if (!string.IsNullOrWhiteSpace(
                                                                payment.AvatarUrl))
                                    {
                                        <span class="payment-avatar">

                                            <img src="@payment.AvatarUrl"
                                                 alt="@payment.GamerTag" />

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="payment-avatar">
                                            @Initials(payment.GamerTag)
                                        </span>
                                    }

                                    <div>

                                        <strong>
                                            @payment.GamerTag
                                        </strong>

                                        <small>
                                            @payment.Email
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <div class="payment-reference">

                                    <strong>
                                        @ShortReference(
                                        payment.TransactionReference)
                            </strong>

                            <small>
                                @GetTypeText(payment.Type)
                            </small>

                        </div>

                    </td>


                    <td>

                        <div class="payment-purpose">

                            <strong>
                                @(payment.TournamentName
                                                                ?? GetTypeText(payment.Type))
                            </strong>

                            @if (!string.IsNullOrWhiteSpace(
                                                        payment.GameName))
                                    {
                                        <small>
                                            @payment.GameName
                                        </small>
                                    }

                                </div>

                            </td>


                            <td>

                                <strong class="payment-amount">
                                    @FormatMoney(
                                    payment.Amount,
                                                        payment.Currency)
                        </strong>

                    </td>


                    <td>

                        <span class="payment-method">
                            @GetMethodText(payment.Method)
                        </span>

                    </td>


                    <td>

                        <span class="@GetStatusClass(
                                                                               payment.Status)">

                            <span class="payment-status-dot">
                            </span>

                                    @GetStatusText(payment.Status)

                                </span>

                            </td>


                            <td>

                                <div class="payment-date">

                                    <strong>
                                        @payment.CreatedAt
                                        .ToString("dd MMM yyyy")
                                    </strong>

                                    <small>
                                        @payment.CreatedAt
                                        .ToString("HH:mm")
                                    </small>

                                </div>

                            </td>


                            <td class="adm-row-actions payment-actions">

                                <button type="button"
                                        @onclick="() =>
                                                                            OpenDetailsAsync(payment.Id)">

                            View

                                </button>


                        @if (payment.Status ==
                                                PaymentStatus.Pending)
                                {
                                    <button type="button"
                                            @onclick="() =>
                                            OpenCompleteModal(payment)">

                            Complete

                                    </button>

                                    <button type="button"
                                            class="danger"
                                            @onclick="() =>
                                                                                RequestAction(
                                                                                    payment,
                                                                                    PaymentAction.Fail)">

                            Fail

                                    </button>
                                                }

                            </td>

                        </tr>
                    }

            </tbody>

        </table>

    </div>


    <div class="payment-pagination">

        <span class="adm-result-count">

            Showing
            @pagedResult.FirstItemNumber–@pagedResult.LastItemNumber
            of
            @pagedResult.TotalCount

        </span>


        <div class="payment-pagination-actions">

            <select value="@pageSize"
                    @onchange="PageSizeChangedAsync">

                <option value="25">25 per page</option>
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>

            </select>


            <button type="button"
                    class="adm-button secondary"
                    disabled="@(!pagedResult.HasPreviousPage)"
                    @onclick="PreviousPageAsync">

                ← Previous

            </button>


            <span class="adm-result-count">

                Page @pagedResult.Page of
                @(pagedResult.TotalPages == 0
                                ? 1
                                : pagedResult.TotalPages)

            </span>


                <button type="button"
                        class="adm-button secondary"
                        disabled="@(!pagedResult.HasNextPage)"
                        @onclick="NextPageAsync">

                    Next →

                </button>

            </div>

        </div>
        }

</section>


@* =========================================================
   DETAILS MODAL
   ========================================================= *@

<AdminModal IsOpen="@showDetailsModal"
            Eyebrow="Transaction"
            Title="Payment details"
            OnClose="CloseDetails">

    <ChildContent>

        @if (selectedDetails is not null)
        {
            <div class="payment-details">


                <div class="payment-details-header">

                    <div>

                        <span class="payment-detail-label">
                            Amount
                        </span>

                        <strong class="payment-detail-amount">
                            @FormatMoney(
                            selectedDetails.Amount,
                                                selectedDetails.Currency)
                    </strong>

                </div>


                <span class="@GetStatusClass(
                                                           selectedDetails.Status)">

                    <span class="payment-status-dot">
                    </span>

                        @GetStatusText(
                                        selectedDetails.Status)

                </span>

            </div>


            <div class="payment-detail-section">

                <span class="payment-section-title">
                    Transaction
                </span>


                <div class="payment-detail-grid">

                    <div>
                        <span>Reference</span>
                        <strong>
                            @selectedDetails.TransactionReference
                        </strong>
                    </div>

                    <div>
                        <span>Type</span>
                        <strong>
                            @GetTypeText(selectedDetails.Type)
                        </strong>
                    </div>

                    <div>
                        <span>Method</span>
                        <strong>
                            @GetMethodText(selectedDetails.Method)
                        </strong>
                    </div>

                    <div>
                        <span>Currency</span>
                        <strong>
                            @selectedDetails.Currency
                        </strong>
                    </div>

                    <div>
                        <span>Provider</span>
                        <strong>
                            @(selectedDetails.PaymentProvider
                                                        ?? "—")
                                                           </strong>
                                                       </div>

                    <div>
                        <span>Provider reference</span>
                        <strong>
                            @(selectedDetails.ProviderReference
                                                        ?? "—")
                        </strong>
                    </div>

                    </div>

                </div>


                <div class="payment-detail-section">

                    <span class="payment-section-title">
                        Player
                    </span>


                    <div class="payment-detail-grid">

                        <div>
                            <span>Gamer tag</span>
                            <strong>
                                @selectedDetails.GamerTag
                            </strong>
                        </div>

                        <div>
                            <span>Name</span>
                            <strong>
                                @selectedDetails.FullName
                            </strong>
                        </div>

                        <div class="wide">
                            <span>Email</span>
                            <strong>
                                @selectedDetails.Email
                            </strong>
                        </div>

                    </div>

                </div>


            @if (selectedDetails.TournamentId.HasValue)
                {
                    <div class="payment-detail-section">

                        <span class="payment-section-title">
                            Tournament
                        </span>


                        <div class="payment-detail-grid">

                            <div>
                                <span>Tournament</span>
                                <strong>
                                    @selectedDetails.TournamentName
                                </strong>
                            </div>

                            <div>
                                <span>Game</span>
                                <strong>
                                    @selectedDetails.GameName
                                </strong>
                            </div>

                        </div>

                    </div>
                }


            <div class="payment-detail-section">

                <span class="payment-section-title">
                    Timeline
                </span>


                <div class="payment-detail-grid">

                    <div>
                        <span>Created</span>
                        <strong>
                            @selectedDetails.CreatedAt
                            .ToString("dd MMM yyyy HH:mm")
                        </strong>
                    </div>

                    <div>
                        <span>Paid</span>
                        <strong>
                            @(selectedDetails.PaidAt
                                                        ?.ToString("dd MMM yyyy HH:mm")
                                                        ?? "Not completed")
                        </strong>
                    </div>

                    </div>

                </div>

            </div>
                }

    </ChildContent>


    <Footer>

        <button type="button"
                class="adm-button secondary"
                @onclick="CloseDetails">

            Close

        </button>

    </Footer>

</AdminModal>


@* =========================================================
   COMPLETE PAYMENT
   ========================================================= *@

<AdminModal IsOpen="@showCompleteModal"
            Eyebrow="Payment reconciliation"
            Title="Complete payment"
            OnClose="CloseCompleteModal">

    <ChildContent>

        @if (selectedPayment is not null)
        {
            <div class="payment-complete-summary">

                <span>
                    You are confirming payment of
                </span>

                <strong>
                    @FormatMoney(
                    selectedPayment.Amount,
                                selectedPayment.Currency)
            </strong>

            <small>
                @selectedPayment.GamerTag ·
                @(selectedPayment.TournamentName
                                ?? GetTypeText(selectedPayment.Type))
            </small>

            </div>


            <div class="adm-form-grid">

                <label>
                    Payment provider

                    <input @bind="completeProvider"
                           placeholder="e.g. Paystack" />
                </label>


                <label>
                    Provider reference

                    <input @bind="completeProviderReference"
                           placeholder="Provider transaction ID" />
                </label>

            </div>
                }

    </ChildContent>


    <Footer>

        <button type="button"
                class="adm-button secondary"
                disabled="@isProcessing"
                @onclick="CloseCompleteModal">

            Cancel

        </button>


        <button type="button"
                class="adm-button primary"
                disabled="@isProcessing"
                @onclick="CompletePaymentAsync">

            @(isProcessing
                        ? "Completing..."
                        : "Confirm payment")

        </button>

    </Footer>

</AdminModal>


<ConfirmDialog IsOpen="@showConfirmation"
               Title="@ConfirmationTitle"
               Message="@ConfirmationMessage"
               ConfirmText="@ConfirmationButtonText"
               ProcessingText="Processing..."
               IsProcessing="@isProcessing"
               OnConfirm="ConfirmActionAsync"
               OnCancel="CancelAction" />


@code {

    private PagedResult<PaymentDto>
        pagedResult = new();

    private PaymentSummaryDto
        summary = new();


    // FILTERS

    private string search = string.Empty;

    private PaymentStatus? statusFilter;

    private PaymentType? typeFilter;

    private PaymentMethod? methodFilter;

    private int currentPage = 1;

    private int pageSize = 25;

    private int searchVersion;


    // STATE

    private bool isLoading;

    private bool isProcessing;


    // DETAILS

    private bool showDetailsModal;

    private PaymentDetailsDto? selectedDetails;


    // COMPLETE

    private bool showCompleteModal;

    private PaymentDto? selectedPayment;

    private string completeProvider = string.Empty;

    private string completeProviderReference = string.Empty;


    // CONFIRMATION

    private bool showConfirmation;

    private PaymentAction pendingAction;


    // =====================================================
    // INIT
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // Sequential intentionally: scoped DbContext.

        await LoadSummaryAsync();

        await LoadPaymentsAsync();
    }


    // =====================================================
    // LOAD
    // =====================================================

    private async Task LoadSummaryAsync()
    {
        var result =
            await PaymentService.GetSummaryAsync();

        if (result.Succeeded &&
            result.Value is not null)
        {
            summary = result.Value;
        }
    }


    private async Task LoadPaymentsAsync()
    {
        isLoading = true;

        try
        {
            var result =
                await PaymentService.GetPagedAsync(
                    currentPage,
                    pageSize,
                    search,
                    statusFilter,
                    typeFilter,
                    methodFilter);

            if (!result.Succeeded ||
                result.Value is null)
            {
                pagedResult = new();

                Toast.Error(
                    result.Error ??
                    "Unable to load payments.");

                return;
            }

            pagedResult = result.Value;

            currentPage =
                pagedResult.Page;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            pagedResult = new();

            Toast.Error(
                "Something went wrong while loading payments.");
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task RefreshAsync()
    {
        await LoadSummaryAsync();

        await LoadPaymentsAsync();
    }


    // =====================================================
    // SEARCH
    // =====================================================

    private async Task HandleSearchInput(
        ChangeEventArgs args)
    {
        search =
            args.Value?.ToString() ?? string.Empty;

        currentPage = 1;

        var version =
            ++searchVersion;

        await Task.Delay(350);

        if (version != searchVersion)
            return;

        await LoadPaymentsAsync();
    }


    // =====================================================
    // FILTERS
    // =====================================================

    private string SelectedStatusValue =>
        statusFilter.HasValue
            ? ((int)statusFilter.Value).ToString()
            : string.Empty;


    private string SelectedTypeValue =>
        typeFilter.HasValue
            ? ((int)typeFilter.Value).ToString()
            : string.Empty;


    private string SelectedMethodValue =>
        methodFilter.HasValue
            ? ((int)methodFilter.Value).ToString()
            : string.Empty;


    private async Task StatusChangedAsync(
        ChangeEventArgs args)
    {
        statusFilter =
            ParseEnum<PaymentStatus>(
                args.Value?.ToString());

        currentPage = 1;

        await LoadPaymentsAsync();
    }


    private async Task TypeChangedAsync(
        ChangeEventArgs args)
    {
        typeFilter =
            ParseEnum<PaymentType>(
                args.Value?.ToString());

        currentPage = 1;

        await LoadPaymentsAsync();
    }


    private async Task MethodChangedAsync(
        ChangeEventArgs args)
    {
        methodFilter =
            ParseEnum<PaymentMethod>(
                args.Value?.ToString());

        currentPage = 1;

        await LoadPaymentsAsync();
    }


    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(search) ||
        statusFilter.HasValue ||
        typeFilter.HasValue ||
        methodFilter.HasValue;


    private async Task ClearFiltersAsync()
    {
        search = string.Empty;

        statusFilter = null;

        typeFilter = null;

        methodFilter = null;

        currentPage = 1;

        searchVersion++;

        await LoadPaymentsAsync();
    }


    // =====================================================
    // PAGINATION
    // =====================================================

    private async Task PageSizeChangedAsync(
        ChangeEventArgs args)
    {
        if (!int.TryParse(
                args.Value?.ToString(),
                out var value))
            return;

        pageSize = value;

        currentPage = 1;

        await LoadPaymentsAsync();
    }


    private async Task PreviousPageAsync()
    {
        if (!pagedResult.HasPreviousPage)
            return;

        currentPage--;

        await LoadPaymentsAsync();
    }


    private async Task NextPageAsync()
    {
        if (!pagedResult.HasNextPage)
            return;

        currentPage++;

        await LoadPaymentsAsync();
    }


    // =====================================================
    // DETAILS
    // =====================================================

    private async Task OpenDetailsAsync(Guid id)
    {
        var result =
            await PaymentService.GetByIdAsync(id);

        if (!result.Succeeded ||
            result.Value is null)
        {
            Toast.Warning(
                result.Error ??
                "Unable to load payment.");

            return;
        }

        selectedDetails =
            result.Value;

        showDetailsModal =
            true;
    }


    private void CloseDetails()
    {
        showDetailsModal = false;

        selectedDetails = null;
    }


    // =====================================================
    // COMPLETE
    // =====================================================

    private void OpenCompleteModal(
        PaymentDto payment)
    {
        selectedPayment = payment;

        completeProvider =
            payment.PaymentProvider ?? string.Empty;

        completeProviderReference =
            payment.ProviderReference ?? string.Empty;

        showCompleteModal = true;
    }


    private async Task CompletePaymentAsync()
    {
        if (selectedPayment is null ||
            isProcessing)
            return;

        isProcessing = true;

        try
        {
            var result =
                await PaymentService.CompleteAsync(
                    new CompletePaymentRequest
                    {
                        PaymentId =
                            selectedPayment.Id,

                        PaymentProvider =
                            completeProvider,

                        ProviderReference =
                            completeProviderReference
                    });

            if (!result.Succeeded)
            {
                Toast.Warning(
                    result.Error ??
                    "Unable to complete payment.");

                return;
            }

            Toast.Success(
                result.Message ??
                "Payment completed.");

            showCompleteModal = false;

            selectedPayment = null;

            completeProvider = string.Empty;

            completeProviderReference = string.Empty;

            await RefreshAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }


    private void CloseCompleteModal()
    {
        if (isProcessing)
            return;

        showCompleteModal = false;

        selectedPayment = null;

        completeProvider = string.Empty;

        completeProviderReference = string.Empty;
    }


    // =====================================================
    // FAIL / CANCEL
    // =====================================================

    private void RequestAction(
        PaymentDto payment,
        PaymentAction action)
    {
        selectedPayment = payment;

        pendingAction = action;

        showConfirmation = true;
    }


    private async Task ConfirmActionAsync()
    {
        if (selectedPayment is null ||
            isProcessing)
            return;

        isProcessing = true;

        try
        {
            Result result =
                pendingAction switch
                {
                    PaymentAction.Fail =>
                        await PaymentService
                            .MarkFailedAsync(
                                selectedPayment.Id),

                    PaymentAction.Cancel =>
                        await PaymentService
                            .CancelAsync(
                                selectedPayment.Id),

                    _ =>
                        Result.Failure(
                            "Unsupported payment action.")
                };

            if (!result.Succeeded)
            {
                Toast.Warning(
                    result.Error ??
                    "Unable to update payment.");

                return;
            }

            Toast.Success(
                result.Message ??
                "Payment updated.");

            showConfirmation = false;

            selectedPayment = null;

            await RefreshAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }


    private void CancelAction()
    {
        if (isProcessing)
            return;

        showConfirmation = false;

        selectedPayment = null;
    }


    // =====================================================
    // HELPERS
    // =====================================================

    private static TEnum? ParseEnum<TEnum>(
        string? value)
        where TEnum : struct, Enum
    {
        if (!int.TryParse(value, out var number))
            return null;

        if (!Enum.IsDefined(
                typeof(TEnum),
                number))
            return null;

        return (TEnum)Enum.ToObject(
            typeof(TEnum),
            number);
    }


    private static string GetStatusText(
        PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending =>
                "Pending",

            PaymentStatus.Completed =>
                "Completed",

            PaymentStatus.Failed =>
                "Failed",

            PaymentStatus.Refunded =>
                "Refunded",

            PaymentStatus.Cancelled =>
                "Cancelled",

            _ => status.ToString()
        };
    }


    private static string GetStatusClass(
        PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Completed =>
                "adm-status payment-completed",

            PaymentStatus.Pending =>
                "adm-status payment-pending",

            PaymentStatus.Failed =>
                "adm-status payment-failed",

            PaymentStatus.Refunded =>
                "adm-status payment-refunded",

            PaymentStatus.Cancelled =>
                "adm-status payment-cancelled",

            _ => "adm-status"
        };
    }


    private static string GetTypeText(
        PaymentType type)
    {
        return type switch
        {
            PaymentType.TournamentEntry =>
                "Tournament entry",

            PaymentType.PrizePayout =>
                "Prize payout",

            PaymentType.Refund =>
                "Refund",

            _ => type.ToString()
        };
    }


    private static string GetMethodText(
        PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.Cash =>
                "Cash",

            PaymentMethod.BankTransfer =>
                "Bank transfer",

            PaymentMethod.Card =>
                "Card",

            PaymentMethod.MobileMoney =>
                "Mobile money",

            PaymentMethod.Wallet =>
                "Wallet",

            PaymentMethod.USSD =>
                "USSD",

            PaymentMethod.FeeWaiver =>
                "Fee waiver",

            PaymentMethod.Other =>
                "Other",

            _ => method.ToString()
        };
    }


    private static string FormatMoney(
        decimal amount,
        string currency)
    {
        return currency.ToUpperInvariant() switch
        {
            "NGN" => $"₦{amount:N0}",
            "GBP" => $"£{amount:N2}",
            "USD" => $"${amount:N2}",
            "EUR" => $"€{amount:N2}",
            _ => $"{currency} {amount:N2}"
        };
    }


    private static string Initials(
        string gamerTag)
    {
        if (string.IsNullOrWhiteSpace(gamerTag))
            return "P";

        var value = gamerTag.Trim();

        return value.Length >= 2
            ? value[..2].ToUpperInvariant()
            : value.ToUpperInvariant();
    }


    private static string ShortReference(
        string reference)
    {
        if (string.IsNullOrWhiteSpace(reference))
            return "—";

        return reference.Length <= 18
            ? reference
            : $"{reference[..15]}…";
    }


    private string ConfirmationTitle =>
        pendingAction switch
        {
            PaymentAction.Fail =>
                "Mark payment as failed?",

            PaymentAction.Cancel =>
                "Cancel payment?",

            _ => "Confirm action?"
        };


    private string ConfirmationButtonText =>
        pendingAction switch
        {
            PaymentAction.Fail =>
                "Mark failed",

            PaymentAction.Cancel =>
                "Cancel payment",

            _ => "Confirm"
        };


    private string ConfirmationMessage
    {
        get
        {
            if (selectedPayment is null)
                return "Are you sure?";

            return pendingAction switch
            {
                PaymentAction.Fail =>
                    $"Mark payment {selectedPayment.TransactionReference} for {selectedPayment.GamerTag} as failed?",

                PaymentAction.Cancel =>
                    $"Cancel payment {selectedPayment.TransactionReference} for {selectedPayment.GamerTag}?",

                _ => "Are you sure?"
            };
        }
    }


    private enum PaymentAction
    {
        None = 0,
        Fail = 1,
        Cancel = 2
    }
}
