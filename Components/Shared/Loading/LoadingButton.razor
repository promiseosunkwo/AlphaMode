@* Forms receive the submitting class in loading.js, which reveals the busy label. *@
<button type="@Type" class="@CssClass" data-loading-submit disabled="@Disabled">
    <span class="loading-button-idle">@ChildContent</span>
    <span class="loading-button-busy" aria-live="polite">
        <LoadingSpinner Size="small" Label="@LoadingText" /> @LoadingText
    </span>
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Working...";
    [Parameter] public string CssClass { get; set; } = "btn btn-primary";
    [Parameter] public string Type { get; set; } = "submit";
    [Parameter] public bool Disabled { get; set; }
}

