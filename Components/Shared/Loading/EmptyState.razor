<div class="resource-state" role="status">
    <span class="resource-state-icon" aria-hidden="true">@Icon</span>
    <h3>@Title</h3><p>@Message</p>@Action
</div>
@code {
    [Parameter] public string Icon { get; set; } = "◇";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string Message { get; set; } = "New content will appear here when it is available.";
    [Parameter] public RenderFragment? Action { get; set; }
}

