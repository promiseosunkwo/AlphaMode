<div class="loading-overlay-host" aria-busy="@IsLoading">
    @ChildContent
    @if (IsLoading)
    {
        <div class="loading-overlay" role="status"><LoadingSpinner Label="@Label" /><span>@Label</span></div>
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Label { get; set; } = "Loading...";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

