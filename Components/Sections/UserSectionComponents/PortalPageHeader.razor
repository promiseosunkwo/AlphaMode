<header class="portal-page-header"><div><span class="portal-eyebrow">@Eyebrow</span><h1>@Title</h1><p>@Description</p></div>@Actions</header>
@code {
    [Parameter] public string Eyebrow { get; set; } = "Player portal";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
}

