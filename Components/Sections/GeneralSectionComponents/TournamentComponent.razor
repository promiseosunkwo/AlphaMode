 <!-- TOURNAMENTS -->
<section id="tournaments" class="section dark-section">
    <div class="alpha-container">
        <div class="section-heading">
            <p class="eyebrow">Upcoming Events</p>
            <h2>Join A Tournament</h2>
        </div>

        <div class="tournament-grid">
            @foreach (var tournament in Tournaments)
            {
                <div class="tournament-card">
                    <div class="card-top">
                        <span>@tournament.Game</span>
                        <span>@tournament.Status</span>
                    </div>

                    <h3>@tournament.Name</h3>
                    <p>@tournament.Location</p>

                    <div class="tournament-info">
                        <div>
                            <span>Players</span>
                            <strong>@tournament.Players</strong>
                        </div>
                        <div>
                            <span>Entry</span>
                            <strong>@tournament.EntryFee</strong>
                        </div>
                        <div>
                            <span>Prize</span>
                            <strong>@tournament.Prize</strong>
                        </div>
                    </div>

                    <a href="/tournaments" class="btn btn-outline w-100">View Details</a>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<TournamentItem> Tournaments = new()
    {
        new TournamentItem
        {
            Name = "FIFA 25 Manchester Clash",
            Game = "FIFA",
