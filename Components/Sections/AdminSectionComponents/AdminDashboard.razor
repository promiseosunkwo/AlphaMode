<div class="dashboard-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h1>Dashboard</h1>
            <p>
                Welcome back. Here's what's happening today.
            </p>
        </div>

        <button class="create-btn">
            + Create Tournament
        </button>

    </div>

    <!-- STATS -->
    <div class="stats-grid">

        <div class="stat-card">
            <span>Total Players</span>
            <h2>1,254</h2>
            <small>+12% this month</small>
        </div>

        <div class="stat-card">
            <span>Active Tournaments</span>
            <h2>8</h2>
            <small>3 currently live</small>
        </div>

        <div class="stat-card">
            <span>Total Revenue</span>
            <h2>£12,580</h2>
            <small>+18% this month</small>
        </div>

        <div class="stat-card">
            <span>Matches Played</span>
            <h2>456</h2>
            <small>Today: 22</small>
        </div>

    </div>

    <!-- SECOND ROW -->
    <div class="dashboard-row">

        <!-- LIVE MATCHES -->
        <div class="panel large">

            <div class="panel-header">
                <h3>Live Matches</h3>
            </div>

            <div class="live-match">

                <div>
                    <strong>ToyinFC</strong>
                    vs
                    <strong>ShadowX</strong>
                </div>

                <div class="score">
                    2 - 1
                </div>

            </div>

            <div class="live-match">

                <div>
                    <strong>NeoBlade</strong>
                    vs
                    <strong>KingJay</strong>
                </div>

                <div class="score">
                    0 - 0
                </div>

            </div>

        </div>

        <!-- TOP PLAYERS -->
        <div class="panel">

            <div class="panel-header">
                <h3>Top Players</h3>
            </div>

            <div class="player-row">
                #1 ToyinFC
            </div>

            <div class="player-row">
                #2 NeoBlade
            </div>

            <div class="player-row">
                #3 ShadowX
            </div>

            <div class="player-row">
                #4 FatalKen
            </div>

        </div>

    </div>

    <!-- RECENT TOURNAMENTS -->
    <div class="panel">

        <div class="panel-header">
            <h3>Recent Tournaments</h3>
        </div>

        <table class="admin-table">

            <thead>
                <tr>
                    <th>Tournament</th>
                    <th>Game</th>
                    <th>Players</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>Alpha Cup</td>
                    <td>EA FC 26</td>
                    <td>32</td>
                    <td>
                        <span class="badge live">
                            Live
                        </span>
                    </td>
                </tr>

                <tr>
                    <td>Mortal Clash</td>
                    <td>Mortal Kombat</td>
                    <td>16</td>
                    <td>
                        <span class="badge upcoming">
                            Upcoming
                        </span>
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>