@rendermode InteractiveServer

@using AlphaMode.Application.Common.Models
@using AlphaMode.Application.Games.DTOs
@using AlphaMode.Application.Games.Interfaces
@using AlphaMode.Application.Tournaments.DTOs
@using AlphaMode.Application.Tournaments.Interfaces
@using AlphaMode.Components.Layout
@using AlphaMode.Components.Sections.AdminSectionComponents
@using AlphaMode.Components.Sections.AdminSectionComponents.Models
@using AlphaMode.Components.Shared.ConfirmDialog
@using AlphaMode.Components.Shared.Toast
@using AlphaMode.Domain.Entities
@using AlphaMode.Domain.Enums
@using AlphaMode.Services


@inject ITournamentLifecycleService LifecycleService
@inject NavigationManager Navigation
@inject ITournamentService TournamentService
@inject IGameService GameService
@inject ToastService Toast

@layout AdminLayout

<PageTitle>Tournaments · AlphaMode Admin</PageTitle>

<ToastContainer />


<AdminPageHeader
    Title="Tournaments"
    Description="Create competitions, control registration and manage their lifecycle.">

    <Actions>
        <button type="button"
                class="adm-button primary"
                @onclick="OpenCreateModal">
            ＋ New tournament
        </button>
    </Actions>

</AdminPageHeader>


<section class="adm-panel">

    <div class="adm-toolbar">

        <label class="adm-search">

            <span>⌕</span>

            <input placeholder="Search tournaments…"
                   @bind="query"
                   @bind:event="oninput" />

        </label>


        <select @bind="statusFilter">

            <option value="All">
                All statuses
            </option>

            @foreach (var status in Enum.GetValues<TournamentStatus>())
            {
                <option value="@status.ToString()">
                    @status
                </option>
            }

        </select>


        <span class="adm-result-count">@FilteredTournaments.Count() results</span>

    </div>


    @if ( isLoading)
    {
        <div class="adm-empty-state">
            Loading tournaments...
        </div>
    }
    else if (!FilteredTournaments.Any())
    {
        <div class="adm-empty-state">

            @if (string.IsNullOrWhiteSpace(query)
                 && statusFilter == "All")
            {
                <p>No tournaments have been created yet.</p>
            }
            else
            {
                <p>No tournaments match your filters.</p>
            }

        </div>
    }
    else
    {
        <div class="adm-table-wrap">

            <table class="adm-table">

                <thead>
                    <tr>
                        <th>Tournament</th>
                        <th>Starts</th>
                        <th>Registration</th>
                        <th>Status</th>
                        <th class="adm-actions-heading">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var tournament in FilteredTournaments)
                    {
                        <tr @key="tournament.Id">

                            @* Tournament *@
                            <td>
                                <div class="">
                                    <strong>@tournament.Name</strong>
                                    <small>@tournament.GameName</small>
                                </div>
                            </td>


                            @* Start date *@
                            <td>
                                <span class="adm-table-date">
                                    @tournament.StartDate.ToString("dd MMM yyyy")
                                </span>
                            </td>


                            @* Registration *@
                            <td>
                                <div class="adm-registration-cell">

                                    <div class="adm-progress">
                                        <span style="@GetRegistrationProgressStyle(tournament)">
                                        </span>
                                    </div>

                                    <small>
                                        @tournament.RegisteredPlayers / @tournament.MaxPlayers players
                                    </small>

                                </div>
                            </td>


                            @* Status *@
                            <td>
                                <div class="adm-tournament-status-cell">

                                    <span class="adm-status @GetStatusCss(tournament.Status)">
                                        @FormatTournamentStatus(tournament.Status)
                                    </span>

                                    <small class="adm-status-description">
                                        @GetTournamentStatusDescription(tournament.Status)
                                    </small>

                                </div>
                            </td>


                            @* Actions *@
                            <td>
                                <div class="adm-tournament-row-actions">

                                    @* Management actions *@
                                    <div class="adm-action-group">

                                        <button type="button"
                                                class="adm-table-action"
                                                disabled="@IsProcessing(tournament.Id)"
                                                @onclick="() => OpenEditModal(tournament.Id)">
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="adm-table-action"
                                                disabled="@IsProcessing(tournament.Id)"
                                                @onclick="() => ManageParticipants(tournament.Id)">
                                            Participants
                                        </button>

                                        @if (tournament.Status == TournamentStatus.Draft)
                                        {
                                            <button type="button"
                                                    class="adm-table-action danger"
                                                    disabled="@IsProcessing(tournament.Id)"
                                                    @onclick="() => RequestDelete(tournament)">
                                                Delete
                                            </button>
                                        }

                                    </div>


                                    @* Lifecycle actions *@
                                    @if (HasLifecycleActions(tournament.Status))
                                    {
                                        <div class="adm-lifecycle-row">

                                            <span class="adm-lifecycle-label">
                                                Lifecycle
                                            </span>

                                            <div class="adm-lifecycle-actions">

                                                @if (tournament.Status == TournamentStatus.Draft)
                                                {
                                                    <button type="button"
                                                            class="adm-table-action lifecycle-primary"
                                                            disabled="@IsLifecycleProcessing(tournament.Id)"
                                                            @onclick="() => AskPublishTournament(tournament)">
                                                        Publish
                                                    </button>
                                                }

                                                else if (tournament.Status == TournamentStatus.Upcoming)
                                                {
                                                    <button type="button"
                                                            class="adm-table-action lifecycle-primary"
                                                            disabled="@IsLifecycleProcessing(tournament.Id)"
                                                            @onclick="() => AskStartTournament(tournament)">
                                                        Start
                                                    </button>

                                                    <button type="button"
                                                            class="adm-table-action lifecycle-danger"
                                                            disabled="@IsLifecycleProcessing(tournament.Id)"
                                                            @onclick="() => AskCancelTournament(tournament)">
                                                        Cancel
                                                    </button>
                                                }

                                                else if (tournament.Status == TournamentStatus.RegistrationOpen)
                                                {
                                                    <button type="button"
                                                            class="adm-table-action lifecycle-danger"
                                                            disabled="@IsLifecycleProcessing(tournament.Id)"
                                                            @onclick="() => AskCancelTournament(tournament)">
                                                        Cancel
                                                    </button>
                                                }

                                                else if (tournament.Status == TournamentStatus.Live)
                                                {
                                                    <button type="button"
                                                            class="adm-table-action lifecycle-complete"
                                                            disabled="@IsLifecycleProcessing(tournament.Id)"
                                                            @onclick="() => AskCompleteTournament(tournament)">
                                                        Complete
                                                    </button>
                                                }

                                            </div>

                                        </div>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</section>


    <AdminModal IsOpen="@showModal"
                Eyebrow="Tournament management"
                Title="@ModalTitle"
                EditContext="@editContext"
                OnValidSubmit="SaveTournamentAsync"
                OnClose="CloseModal">

    <ChildContent>

            <div class="adm-form-grid">

                <label class="span-2"> Tournament name

                    <InputText @bind-Value="model.Name" placeholder="e.g. AlphaMode FC Championship" />
                    <ValidationMessage For="@(() => model.Name)" />

                </label>


                <label class="span-2"> Description
                    <InputTextArea @bind-Value="model.Description" placeholder="Describe the tournament..." />

                    <ValidationMessage For="@(() => model.Description)" />
                </label>


                <label> Game
                    <InputSelect @bind-Value="model.GameId">
                    <option value=""> Select game</option>

                        @foreach (var game in activeGames)
                        {
                            <option value="@game.Id">
                                @game.Name · @game.Version · @game.Platform
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.GameId)" />

                </label>


                <label> Format
                    <InputSelect @bind-Value="model.Format">

                        <option value="">
                            Select format
                        </option>

                        @foreach (var format in Enum.GetValues<TournamentFormat>())
                        {
                            <option value="@format">
                                @format
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => model.Format)" />

                </label>


                <label>

                    Tournament starts

                <InputDate @bind-Value="model.StartDate"
                           Type="InputDateType.DateTimeLocal"
                           class="adm-input" />

                    <ValidationMessage For="@(() => model.StartDate)" />

                </label>


                <label>

                    Tournament ends

                <InputDate @bind-Value="model.EndDate"
                           Type="InputDateType.DateTimeLocal"
                           class="adm-input" />

                    <ValidationMessage For="@(() => model.EndDate)" />

                </label>


                <label>

                    Registration opens

                <InputDate @bind-Value="model.RegistrationOpenDate"
                           Type="InputDateType.DateTimeLocal"
                           class="adm-input" />

                <ValidationMessage For="@(() => model.RegistrationOpenDate)" />

                </label>


                <label>

                    Registration closes

                <InputDate @bind-Value="model.RegistrationDeadline"
                           Type="InputDateType.DateTimeLocal"
                           class="adm-input" />

                <ValidationMessage For="@(() => model.RegistrationDeadline)" />

                </label>


                <label>

                    Maximum players

                    <InputNumber @bind-Value="model.MaxPlayers" />

                    <ValidationMessage For="@(() => model.MaxPlayers)" />

                </label>


                <label>

                    Entry fee

                    <InputNumber @bind-Value="model.EntryFee" />

                    <ValidationMessage For="@(() => model.EntryFee)" />

                </label>


                <label>

                    Legs

                    <InputNumber @bind-Value="model.Legs" />

                    <ValidationMessage For="@(() => model.Legs)" />

                </label>


                <label>

                    Points for win

                    <InputNumber @bind-Value="model.PointsForWin" />

                    <ValidationMessage For="@(() => model.PointsForWin)" />

                </label>


                <label>

                    Points for draw

                    <InputNumber @bind-Value="model.PointsForDraw" />

                    <ValidationMessage For="@(() => model.PointsForDraw)" />

                </label>


                <label>

                    Points for loss

                    <InputNumber @bind-Value="model.PointsForLoss" />

                    <ValidationMessage For="@(() => model.PointsForLoss)" />

                </label>


                <label class="span-2">

                    Image URL

                    <InputText @bind-Value="model.ImageUrl"
                               placeholder="https://..." />

                    <ValidationMessage For="@(() => model.ImageUrl)" />

                </label>


                @* @if (isEditing)
                {
                    <label class="span-2">

                        Status

                        <InputSelect @bind-Value="model.Status">

                            @foreach (var status in Enum.GetValues<TournamentStatus>())
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }

                        </InputSelect>

                    </label>
                } *@

            </div>


    </ChildContent>


        <Footer>

            <button type="button"
                class="adm-button secondary"
                    @onclick="CloseModal">
                Cancel
            </button>

            <button type="submit"
                class="adm-button primary"
                    disabled="@isSaving">

                @if (isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>@(isEditing ? "Save changes" : "Create tournament")</span>
                }

            </button>

        </Footer>

</AdminModal>


<ConfirmDialog
    IsOpen="@showDeleteConfirmation"
    Title="Delete tournament?"
    Message="@deleteConfirmationMessage"
    ConfirmText="Delete tournament"
    ProcessingText="Deleting..."
    IsProcessing="@isDeleting"
    OnConfirm="ConfirmDeleteTournamentAsync"
    OnCancel="CancelDelete" />


<ConfirmDialog IsOpen="@isLifecycleConfirmationOpen"
               Title="@lifecycleConfirmTitle"
               Message="@lifecycleConfirmMessage"
               ConfirmText="@lifecycleConfirmButtonText"
               CancelText="Cancel"
               ProcessingText="@lifecycleProcessingText"
               IsProcessing="@isLifecycleProcessing"
               OnConfirm="ExecuteLifecycleActionAsync"
               OnCancel="CloseLifecycleConfirmation" />

@code {

    // =======================================================
    // DATA
    // =======================================================

    private IReadOnlyList<TournamentDto> tournaments = [];

    private IReadOnlyList<GameDto> activeGames = [];


    // =======================================================
    // FORM
    // =======================================================

    private TournamentFormModel model = new();

    private Guid? editingTournamentId;

    private bool isEditing = false;

    private bool isSaving = false;

    private string ModalTitle => isEditing ? "Edit Tournament" : "Create Tournament";

    private EditContext? editContext;

    // =======================================================
    // PAGE STATE
    // =======================================================

    private bool isLoading;

    private bool showModal;

    private Guid? processingTournamentId;

    private string query = string.Empty;

    private string statusFilter = "All";


    // =======================================================
    // DELETE STATE
    // =======================================================

    private TournamentDto? tournamentToDelete;

    private bool showDeleteConfirmation;

    private bool isDeleting;


    private string deleteConfirmationMessage => tournamentToDelete is null ? "This action cannot be undone." : $"You're about to permanently delete {tournamentToDelete.Name}. This action cannot be undone.";


    // =======================================================
    // TOURNAMENT LIFECYCLE STATE
    // =======================================================
    private TournamentDto? selectedLifecycleTournament;

    private bool isLifecycleConfirmationOpen;

    private bool isLifecycleProcessing;

    private TournamentLifecycleAction pendingLifecycleAction;

    private string lifecycleConfirmTitle = string.Empty;
    private string lifecycleConfirmMessage = string.Empty;
    private string lifecycleConfirmButtonText = string.Empty;
    private string lifecycleProcessingText = string.Empty;

    private enum TournamentLifecycleAction
    {
        None = 0,
        Publish = 1,
        Start = 2,
        Complete = 3,
        Cancel = 4
    }
    // =======================================================
    // FILTERING
    // =======================================================

    private IEnumerable<TournamentDto> FilteredTournaments => tournaments.Where(tournament => (statusFilter == "All" || tournament.Status.ToString() == statusFilter)
            &&
            (
                string.IsNullOrWhiteSpace(query)
                ||
                tournament.Name.Contains(
                    query,
                    StringComparison.OrdinalIgnoreCase)
                ||
                tournament.GameName.Contains(
                    query,
                    StringComparison.OrdinalIgnoreCase)
            ));


    // =======================================================
    // INITIALIZATION
    // =======================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }


    private async Task LoadPageAsync()
    {
        isLoading = true;

        try
        {
            // Load tournaments first
            var tournamentResult = await TournamentService.GetAllAsync();

            if (!tournamentResult.Succeeded)
            {
                tournaments = [];

                Toast.Error(tournamentResult.Error ?? "Unable to load tournaments.");
            }
            else
            {
                tournaments = tournamentResult.Value ?? [];
            }


            // Then load active games
            var gameResult = await GameService.GetActiveAsync();

            if (!gameResult.Succeeded)
            {
                activeGames = [];

                Toast.Error(gameResult.Error ?? "Unable to load games.");
            }
            else
            {
                activeGames = gameResult.Value ?? [];
            }
        }
        catch (Exception)
        {
            tournaments = [];
            activeGames = [];

            // Console.WriteLine(
            //     $"Error loading tournament page: {ex}");

            Toast.Error(
                "Something went wrong while loading tournament data.");
        }
        finally
        {
            isLoading = false;
        }
    }


    // =======================================================
    // CREATE
    // =======================================================


    private void OpenCreateModal()
    {
        model = new TournamentFormModel
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today,
            MaxPlayers = 32,
            Legs = 1,
            PointsForWin = 3,
            PointsForDraw = 1,
            PointsForLoss = 0
        };

        editContext = new EditContext(model);

        isEditing = false;
        editingTournamentId = null;
        showModal = true;
    }


    // =======================================================
    // EDIT
    // =======================================================

    private async Task OpenEditModal(Guid id)
    {
        var result = await TournamentService.GetByIdAsync(id);

        if (!result.Succeeded || result.Value is null)
        {
            Toast.Error(
            result.Error ?? "Unable to load tournament.");

            return;
        }

        var tournament = result.Value;

        model = new TournamentFormModel
        {
            Name = tournament.Name,
            Description = tournament.Description,
            GameId = tournament.GameId,
            Format = tournament.Format,
            StartDate = tournament.StartDate,
            EndDate = tournament.EndDate,
            RegistrationOpenDate = tournament.RegistrationOpenDate,
            RegistrationDeadline = tournament.RegistrationDeadline,
            MaxPlayers = tournament.MaxPlayers,
            EntryFee = tournament.EntryFee,
            Legs = tournament.Legs,
            PointsForWin = tournament.PointsForWin,
            PointsForDraw = tournament.PointsForDraw,
            PointsForLoss = tournament.PointsForLoss,
            ImageUrl = tournament.ImageUrl,
            Status = tournament.Status
        };

        editContext = new EditContext(model);

        editingTournamentId = tournament.Id;
        isEditing = true;
        showModal = true;
    }


    // =======================================================
    // SAVE
    // =======================================================

    private async Task SaveTournamentAsync()
    {
        if (isSaving)
            return;

        isSaving = true;

        try
        {
            if (isEditing)
            {
                await UpdateTournamentAsync();
            }
            else
            {
                await CreateTournamentAsync();
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    // =======================================================
    // CREATE SERVICE CALL
    // =======================================================

    private async Task CreateTournamentAsync()
    {
        try
        {
            var request = new CreateTournamentRequest
                {
                    Name = model.Name,

                    Description = model.Description,

                    GameId = model.GameId!.Value,

                    Format = model.Format!.Value,

                    RegistrationOpenDate  = model.RegistrationOpenDate,

                    RegistrationDeadline = model.RegistrationDeadline,

                    StartDate = model.StartDate,

                    EndDate = model.EndDate,

                    MaxPlayers = model.MaxPlayers,

                    EntryFee = model.EntryFee,

                    Status = model.Status,

                    Legs = model.Legs,

                    PointsForWin = model.PointsForWin,

                    PointsForDraw = model.PointsForDraw,

                    PointsForLoss = model.PointsForLoss,

                    ImageUrl = model.ImageUrl
                };


            var result = await TournamentService.CreateAsync(request);


            if (!result.Succeeded)
            {
                Toast.Warning(result.Error ?? "Unable to create tournament.");
                return;
            }


            Toast.Success(result.Message ?? "Tournament created successfully.");

            CloseModal();

            await LoadTournamentsAsync();
        }
        catch (Exception)
        {
            Toast.Error(
                "Something went wrong while creating the tournament.");
        }
    }


    // =======================================================
    // UPDATE SERVICE CALL
    // =======================================================

    private async Task UpdateTournamentAsync()
    {
        if (!editingTournamentId.HasValue)
            return;


        try
        {
            var request = new UpdateTournamentRequest
                {
                    Id = editingTournamentId.Value,

                    Name = model.Name,

                    Description = model.Description,

                    GameId = model.GameId!.Value,

                    Format = model.Format!.Value,

                    TournamentStartDate = model.StartDate,

                    TournamentEndDate = model.EndDate,

                    RegistrationOpenDate = model.RegistrationOpenDate,

                    RegistrationDeadline = model.RegistrationDeadline,

                    MaxPlayers = model.MaxPlayers,

                    EntryFee = model.EntryFee,

                    Legs = model.Legs,

                    PointsForWin = model.PointsForWin,

                    PointsForDraw = model.PointsForDraw,

                    PointsForLoss = model.PointsForLoss,

                    ImageUrl = model.ImageUrl,

                    Status = model.Status
                };


            var result = await TournamentService.UpdateAsync(request);


            if (!result.Succeeded)
            {
                Toast.Warning(
                    result.Error
                    ?? "Unable to update tournament.");

                return;
            }


            Toast.Success(
                result.Message
                ?? "Tournament updated successfully.");


            CloseModal();

            await LoadTournamentsAsync();
        }
        catch (Exception)
        {
            Toast.Error(
                "Something went wrong while updating the tournament.");
        }
    }


    // =======================================================
    // DELETE
    // =======================================================

    private void RequestDelete(TournamentDto tournament)
    {
        if (processingTournamentId.HasValue ||
            isDeleting)
        {
            return;
        }


        tournamentToDelete =
            tournament;

        showDeleteConfirmation =
            true;
    }


    private async Task ConfirmDeleteTournamentAsync()
    {
        if (tournamentToDelete is null ||
            isDeleting)
        {
            return;
        }


        isDeleting = true;

        try
        {
            var result =
                await TournamentService.DeleteAsync(
                    tournamentToDelete.Id);


            showDeleteConfirmation =
                false;


            if (!result.Succeeded)
            {
                tournamentToDelete = null;

                Toast.Warning(
                    result.Error
                    ?? "Unable to delete tournament.");

                return;
            }


            tournamentToDelete = null;


            Toast.Success(
                result.Message
                ?? "Tournament deleted successfully.");


            await LoadTournamentsAsync();
        }
        catch (Exception)
        {
            showDeleteConfirmation = false;

            tournamentToDelete = null;

            Toast.Error(
                "Something went wrong while deleting the tournament.");
        }
        finally
        {
            isDeleting = false;
        }
    }


    private void CancelDelete()
    {
        if (isDeleting)
            return;


        showDeleteConfirmation = false;

        tournamentToDelete = null;
    }


    // =======================================================
    // RELOAD TOURNAMENTS
    // =======================================================

    private async Task LoadTournamentsAsync()
    {
        try
        {
            var result =
                await TournamentService.GetAllAsync();


            if (!result.Succeeded)
            {
                Toast.Error(
                    result.Error
                    ?? "Unable to reload tournaments.");

                return;
            }


            tournaments =
                result.Value ?? [];
        }
        catch (Exception)
        {
            Toast.Error(
                "Something went wrong while refreshing tournaments.");
        }
    }

    // =======================================================
    // MODAL
    // =======================================================

    private void CloseModal()
    {
        showModal = false;

        editingTournamentId = null;

        isEditing = false;

        editContext = null;

        model = new TournamentFormModel();
    }


    // =======================================================
    // HELPERS
    // =======================================================

    private bool IsProcessing(Guid id)
    {
        return processingTournamentId == id;
    }

    private void ManageParticipants(Guid tournamentId)
    {
        Navigation.NavigateTo($"/admin/tournaments/{tournamentId}/participants");
    }


    private static int GetRegistrationPercent(TournamentDto tournament)
    {
        if (tournament.MaxPlayers <= 0)
            return 0;

        var percentage =
            (int)Math.Round(
                100d
                * tournament.RegisteredPlayers
                / tournament.MaxPlayers);

        return Math.Clamp(
            percentage,
            0,
            100);
    }


    private static string GetRegistrationProgressStyle(
        TournamentDto tournament)
    {
        return $"width:{GetRegistrationPercent(tournament)}%";
    }


    private static string GetStatusCss(
        TournamentStatus status)
    {
        return status
            .ToString()
            .ToLowerInvariant();
    }


    private void AskPublishTournament(TournamentDto tournament)
    {
        if (tournament.Status != TournamentStatus.Draft)
        {
            return;
        }

        selectedLifecycleTournament = tournament;

        pendingLifecycleAction =
            TournamentLifecycleAction.Publish;

        lifecycleConfirmTitle =
            "Publish tournament?";

        lifecycleConfirmMessage =
            $"Publish {tournament.Name}? Registration will open automatically during the configured registration period.";

        lifecycleConfirmButtonText =
            "Publish tournament";

        lifecycleProcessingText =
            "Publishing...";

        isLifecycleConfirmationOpen = true;
    }



    private void AskStartTournament(TournamentDto tournament)
    {
        if (tournament.Status != TournamentStatus.Upcoming)
        {
            return;
        }

        selectedLifecycleTournament = tournament;

        pendingLifecycleAction =
            TournamentLifecycleAction.Start;

        lifecycleConfirmTitle =
            "Start tournament?";

        lifecycleConfirmMessage =
            $"Start {tournament.Name}? At least two checked-in players and generated fixtures are required.";

        lifecycleConfirmButtonText =
            "Start tournament";

        lifecycleProcessingText =
            "Starting...";

        isLifecycleConfirmationOpen = true;
    }


    private void AskCompleteTournament(TournamentDto tournament)
    {
        if (tournament.Status != TournamentStatus.Live)
        {
            return;
        }

        selectedLifecycleTournament = tournament;

        pendingLifecycleAction =
            TournamentLifecycleAction.Complete;

        lifecycleConfirmTitle =
            "Complete tournament?";

        lifecycleConfirmMessage =
            $"Complete {tournament.Name}? All tournament matches must already be completed.";

        lifecycleConfirmButtonText =
            "Complete tournament";

        lifecycleProcessingText =
            "Completing...";

        isLifecycleConfirmationOpen = true;
    }


    private void AskCancelTournament(TournamentDto tournament)
    {
        if (tournament.Status is
            TournamentStatus.Completed or
            TournamentStatus.Cancelled or
            TournamentStatus.Live)
        {
            return;
        }

        selectedLifecycleTournament = tournament;

        pendingLifecycleAction =
            TournamentLifecycleAction.Cancel;

        lifecycleConfirmTitle =
            "Cancel tournament?";

        lifecycleConfirmMessage =
            $"Cancel {tournament.Name}? This will prevent the tournament from continuing through the normal competition lifecycle.";

        lifecycleConfirmButtonText =
            "Cancel tournament";

        lifecycleProcessingText =
            "Cancelling...";

        isLifecycleConfirmationOpen = true;
    }


    private async Task ExecuteLifecycleActionAsync()
    {
        if (selectedLifecycleTournament is null ||
            isLifecycleProcessing ||
            pendingLifecycleAction ==
            TournamentLifecycleAction.None)
        {
            return;
        }

        isLifecycleProcessing = true;

        try
        {
            Result result;

            switch (pendingLifecycleAction)
            {
                case TournamentLifecycleAction.Publish:

                    result =
                        await LifecycleService.PublishAsync(
                            selectedLifecycleTournament.Id);

                    break;

                case TournamentLifecycleAction.Start:

                    result =
                        await LifecycleService.StartAsync(
                            selectedLifecycleTournament.Id);

                    break;

                case TournamentLifecycleAction.Complete:

                    result =
                        await LifecycleService.CompleteAsync(
                            selectedLifecycleTournament.Id);

                    break;

                case TournamentLifecycleAction.Cancel:

                    result =
                        await LifecycleService.CancelAsync(
                            selectedLifecycleTournament.Id);

                    break;

                default:
                    return;
            }

            if (!result.Succeeded)
            {
                Toast.Error(
                    result.Error ??
                    "The tournament status could not be changed.");

                return;
            }

            Toast.Success(
                result.Message ??
                "Tournament updated successfully.");

            ResetLifecycleConfirmation();

            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Toast.Error(
                "Something went wrong while updating the tournament.");
        }
        finally
        {
            isLifecycleProcessing = false;
        }
    }


    private void CloseLifecycleConfirmation()
    {
        if (isLifecycleProcessing)
        {
            return;
        }

        ResetLifecycleConfirmation();
    }

    private void CloseLifecycleConfirmationAfterSuccess()
    {
        ResetLifecycleConfirmation();
    }

    private void ResetLifecycleConfirmation()
    {
        isLifecycleConfirmationOpen = false;

        selectedLifecycleTournament = null;

        pendingLifecycleAction =
            TournamentLifecycleAction.None;

        lifecycleConfirmTitle = string.Empty;
        lifecycleConfirmMessage = string.Empty;
        lifecycleConfirmButtonText = string.Empty;
        lifecycleProcessingText = string.Empty;
    }


    private static string GetTournamentStatusDescription(TournamentStatus status)
    {
        return status switch
        {
            TournamentStatus.Draft =>
                "Not yet published to players.",

            TournamentStatus.Upcoming =>
                "Published but registration is not currently open.",

            TournamentStatus.RegistrationOpen =>
                "Players can currently register for this tournament.",

            TournamentStatus.Live =>
                "Tournament competition is currently in progress.",

            TournamentStatus.Completed =>
                "Tournament competition has finished.",

            TournamentStatus.Cancelled =>
                "Tournament has been cancelled.",

            _ => string.Empty
        };
    }



    private static string FormatTournamentStatus(
    TournamentStatus status)
    {
        return status switch
        {
            TournamentStatus.Draft => "Draft",
            TournamentStatus.Upcoming => "Upcoming",
            TournamentStatus.RegistrationOpen => "Registration Open",
            TournamentStatus.Live => "Live",
            TournamentStatus.Completed => "Completed",
            TournamentStatus.Cancelled => "Cancelled",
            _ => status.ToString()
        };
    }


    private static bool HasLifecycleActions(
    TournamentStatus status)
    {
        return status is
            TournamentStatus.Draft or
            TournamentStatus.Upcoming or
            TournamentStatus.RegistrationOpen or
            TournamentStatus.Live;
    }


    private bool IsLifecycleProcessing(Guid tournamentId)
    {
        return isLifecycleProcessing &&
               selectedLifecycleTournament?.Id == tournamentId;
    }
}