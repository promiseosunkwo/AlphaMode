<header class="adm-page-header">
    <div><p class="adm-eyebrow">@Eyebrow</p><h1>@Title</h1><p class="adm-subtitle">@Description</p></div>
    @if (Actions is not null) { <div class="adm-page-actions">@Actions</div> }
</header>
@code {
    [Parameter] public string Eyebrow { get; set; } = "Admin workspace";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
}
