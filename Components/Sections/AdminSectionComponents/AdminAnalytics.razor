@page "/admin/analytics"
@using AlphaMode.Components.Layout
@using AlphaMode.Web.Components.Layout
@layout AdminLayout

<div class="analytics-page">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h1>Analytics</h1>
            <p>Platform performance and tournament insights</p>
        </div>

        <div class="analytics-actions">
            <button class="btn-export">
                Export Report
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">

        <div class="kpi-card">
            <span>Total Revenue</span>
            <h2>£24,580</h2>
            <small>+18.4%</small>
        </div>

        <div class="kpi-card">
            <span>Total Players</span>
            <h2>1,254</h2>
            <small>+9.2%</small>
        </div>

        <div class="kpi-card">
            <span>Matches Played</span>
            <h2>4,812</h2>
            <small>+12.6%</small>
        </div>

        <div class="kpi-card">
            <span>Active Tournaments</span>
            <h2>8</h2>
            <small>3 Live</small>
        </div>

    </div>

    <!-- CHART ROW -->
    <div class="analytics-row">

        <!-- REVENUE -->
        <div class="analytics-card large">

            <div class="card-header">
                <h3>Revenue Trend</h3>
            </div>

            <div class="chart-placeholder">
                Revenue Chart
            </div>

        </div>

        <!-- PLAYER GROWTH -->
        <div class="analytics-card">

            <div class="card-header">
                <h3>Player Growth</h3>
            </div>

            <div class="growth-stat">
                <h2>+148</h2>
                <span>New Players This Month</span>
            </div>

        </div>

    </div>

    <!-- SECOND ROW -->
    <div class="analytics-row">

        <!-- POPULAR GAMES -->
        <div class="analytics-card">

            <div class="card-header">
                <h3>Popular Games</h3>
            </div>

            <div class="game-list">

                <div class="game-item">
                    <span>EA FC 26</span>
                    <strong>45%</strong>
                </div>

                <div class="game-item">
                    <span>Mortal Kombat</span>
                    <strong>28%</strong>
                </div>

                <div class="game-item">
                    <span>Call of Duty</span>
                    <strong>18%</strong>
                </div>

                <div class="game-item">
                    <span>Tekken 8</span>
                    <strong>9%</strong>
                </div>

            </div>

        </div>

        <!-- TOURNAMENT PERFORMANCE -->
        <div class="analytics-card">

            <div class="card-header">
                <h3>Top Tournaments</h3>
            </div>

            <div class="tournament-list">

                <div class="tournament-item">
                    <span>Alpha Cup</span>
                    <strong>£4,500</strong>
                </div>

                <div class="tournament-item">
                    <span>Elite Series</span>
                    <strong>£3,200</strong>
                </div>

                <div class="tournament-item">
                    <span>Mortal Clash</span>
                    <strong>£2,900</strong>
                </div>

            </div>

        </div>

    </div>

    <!-- ACTIVITY -->
    <div class="analytics-card">

        <div class="card-header">
            <h3>Recent Activity</h3>
        </div>

        <div class="activity-feed">

            <div class="activity-item">
                🎮 New tournament created: Alpha Cup
            </div>

            <div class="activity-item">
                👤 15 new players registered
            </div>

            <div class="activity-item">
                🏆 Tournament completed: Mortal Clash
            </div>

            <div class="activity-item">
                💰 Prize payout processed
            </div>

        </div>

    </div>

</div>